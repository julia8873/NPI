<?xml version="1.0" encoding="utf-8"?>
<!-- Al volver, el papel de encima se retira hacia abajo. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/accelerate_cubic" android:duration="200">
    <translate android:fromYDelta="0" android:toYDelta="6%" />
    <alpha android:fromAlpha="1" android:toAlpha="0" />
</set>
