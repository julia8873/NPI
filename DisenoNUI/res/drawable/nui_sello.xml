<?xml version="1.0" encoding="utf-8"?>
<!-- SELLO de secretaría: doble marco en tinta granada. Úsalo con style="@style/Widget.Nui.Sello". -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <stroke android:width="@dimen/nui_borde_sello" android:color="@color/nui_granada" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape>
            <stroke android:width="@dimen/nui_borde" android:color="@color/nui_granada" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</layer-list>
