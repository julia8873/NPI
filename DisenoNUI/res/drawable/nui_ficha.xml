<?xml version="1.0" encoding="utf-8"?>
<!-- FICHA DE CATÁLOGO: como las fichas de biblioteca. Línea granada bajo la cabecera, esquinas rectas.
     Para libros, asignaturas, profesores, trámites... cualquier "registro". -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="@dimen/nui_sombra_papel" android:top="@dimen/nui_sombra_papel">
        <shape>
            <solid android:color="@color/nui_papel_sombra" />
            <corners android:radius="@dimen/nui_radio_ficha" />
        </shape>
    </item>
    <item android:right="@dimen/nui_sombra_papel" android:bottom="@dimen/nui_sombra_papel">
        <shape>
            <solid android:color="@color/nui_superficie" />
            <stroke android:width="@dimen/nui_borde" android:color="@color/nui_papel_sombra" />
            <corners android:radius="@dimen/nui_radio_ficha" />
        </shape>
    </item>
    <!-- línea roja de cabecera (a 40dp del borde superior) -->
    <item android:top="40dp" android:left="1dp" android:right="4dp" android:gravity="top">
        <shape>
            <size android:height="1dp" />
            <solid android:color="@color/nui_granada" />
        </shape>
    </item>
</layer-list>
