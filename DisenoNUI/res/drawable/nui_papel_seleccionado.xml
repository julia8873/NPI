<?xml version="1.0" encoding="utf-8"?>
<!-- Papel elegido/activo: tinte naranja y sombra en acento. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="@dimen/nui_sombra_papel" android:top="@dimen/nui_sombra_papel">
        <shape>
            <solid android:color="@color/nui_resaltado" />
            <corners android:radius="@dimen/nui_radio_papel" />
        </shape>
    </item>
    <item android:right="@dimen/nui_sombra_papel" android:bottom="@dimen/nui_sombra_papel">
        <shape>
            <solid android:color="@color/nui_resaltado_tinte" />
            <stroke android:width="@dimen/nui_borde" android:color="@color/nui_resaltado" />
            <corners android:radius="@dimen/nui_radio_papel" />
        </shape>
    </item>
</layer-list>
