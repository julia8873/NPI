<?xml version="1.0" encoding="utf-8"?>
<!-- PAPEL APOYADO: tarjeta base del sistema. Sombra dura desplazada abajo-derecha (sin difuminado). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="@dimen/nui_sombra_papel" android:top="@dimen/nui_sombra_papel">
        <shape>
            <solid android:color="@color/nui_papel_sombra" />
            <corners android:radius="@dimen/nui_radio_papel" />
        </shape>
    </item>
    <item android:right="@dimen/nui_sombra_papel" android:bottom="@dimen/nui_sombra_papel">
        <shape>
            <solid android:color="@color/nui_papel" />
            <stroke android:width="@dimen/nui_borde" android:color="@color/nui_papel_sombra" />
            <corners android:radius="@dimen/nui_radio_papel" />
        </shape>
    </item>
</layer-list>
