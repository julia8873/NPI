<?xml version="1.0" encoding="utf-8"?>
<!-- AVISO: nota de papel que flota sobre la pantalla (Deshacer y avisos breves). Papel con borde de tinta y
     sombra dura de tinta: está por encima de todo, como los flotantes, pero se lee como un papel. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="@dimen/nui_sombra_flotante" android:top="@dimen/nui_sombra_flotante">
        <shape>
            <solid android:color="@color/nui_tinta" />
            <corners android:radius="@dimen/nui_radio_papel" />
        </shape>
    </item>
    <item android:right="@dimen/nui_sombra_flotante" android:bottom="@dimen/nui_sombra_flotante">
        <shape>
            <solid android:color="@color/nui_papel" />
            <stroke android:width="@dimen/nui_borde" android:color="@color/nui_tinta" />
            <corners android:radius="@dimen/nui_radio_papel" />
        </shape>
    </item>
</layer-list>
