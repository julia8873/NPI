<?xml version="1.0" encoding="utf-8"?>
<!-- Hoja con la lista de comunidades de chat (design system NUI) -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/nui_superficie">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/nui_espacio_l">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Comunidades de chat"
            android:textAppearance="@style/TextAppearance.Nui.Titular" />

        <TextView
            android:id="@+id/tvSubtituloComunidades"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/nui_espacio_xs"
            android:textAppearance="@style/TextAppearance.Nui.Cuerpo.Secundario" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/nui_espacio_xs"
            android:text="Pulsa un grupo para ver cómo es antes de unirte"
            android:textAppearance="@style/TextAppearance.Nui.Cuerpo.Secundario" />

        <!-- Aquí se añaden las tarjetas por código -->
        <LinearLayout
            android:id="@+id/listaComunidades"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/nui_espacio_m"
            android:orientation="vertical" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
