<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="26dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <!-- Icono de usuario -->
        <ImageView
            android:id="@+id/ivIcono"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="8dp"
            android:src="@drawable/icono" />

        <!-- Etiqueta: Mis datos personales -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="Mis datos personales"
            android:textColor="#333333"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Etiqueta: Nombre -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:text="Nombre"
            android:textColor="#333333"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Campo de entrada: Nombre -->
        <EditText
            android:id="@+id/etNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:paddingVertical="8dp"
            android:paddingHorizontal="14dp"
            android:background="@drawable/cuadro_introducir_datos"
            android:textColor="#000000"
            android:textSize="14sp" />

        <!-- Etiqueta: Contraseña -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:text="Contraseña"
            android:textColor="#333333"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Campo de entrada: Contraseña -->
        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:paddingVertical="8dp"
            android:paddingHorizontal="14dp"
            android:background="@drawable/cuadro_introducir_datos"
            android:inputType="textPassword"
            android:textColor="#000000"
            android:textSize="14sp" />

        <!-- Etiqueta: Grado -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:text="Grado"
            android:textColor="#333333"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Campo de entrada: Grado -->
        <AutoCompleteTextView
            android:id="@+id/etGrado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:paddingVertical="8dp"
            android:paddingHorizontal="14dp"
            android:background="@drawable/cuadro_introducir_datos"
            android:textColor="#000000"
            android:textSize="14sp"
            android:focusable="true"
            android:clickable="true"
            android:focusableInTouchMode="true"
            android:cursorVisible="false"
            android:completionThreshold="0" />

        <!-- Etiqueta: Idioma -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:text="Idioma"
            android:textColor="#333333"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Campo de entrada: Idioma -->
        <AutoCompleteTextView
            android:id="@+id/etIdioma"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:paddingVertical="8dp"
            android:paddingHorizontal="14dp"
            android:background="@drawable/cuadro_introducir_datos"
            android:textColor="#000000"
            android:textSize="14sp"
            android:focusable="true"
            android:clickable="true"
            android:focusableInTouchMode="true"
            android:cursorVisible="false"
            android:completionThreshold="0" />

        <!-- Campo nuevo: Preferencia de dieta / menú vegetariano -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/cuadro_introducir_datos"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌱 Dieta vegetariana"
                    android:textColor="#333333"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mostrar menú vegetariano por defecto"
                    android:textColor="#777777"
                    android:textSize="11sp" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchVegetariano"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Botones de acción: Guardar cambios y Cerrar sesión distribuidos horizontalmente -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- Botón: Guardar cambios -->
            <Button
                android:id="@+id/btnGuardarCambios"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/boton_redondeado"
                android:text="Guardar"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <!-- Botón: Cerrar sesión -->
            <Button
                android:id="@+id/btnLogOut"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/boton_redondeado"
                android:text="Cerrar sesión"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>
