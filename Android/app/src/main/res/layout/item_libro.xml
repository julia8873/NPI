<?xml version="1.0" encoding="utf-8"?>
<!-- Libro de frente en la balda: marco fino y marcas PRESTADO / BÁSICA -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:paddingHorizontal="@dimen/nui_espacio_s">

    <ImageView
        android:id="@+id/ivPortada"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/nui_libro"
        android:importantForAccessibility="no"
        android:paddingStart="@dimen/nui_borde_sello"
        android:paddingTop="@dimen/nui_borde_sello"
        android:paddingEnd="@dimen/nui_libro_canto"
        android:paddingBottom="@dimen/nui_libro_canto"
        android:scaleType="centerCrop"
        android:transitionName="portada"
        app:layout_constraintDimensionRatio="3:4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvPrestado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/nui_marca"
        android:paddingHorizontal="@dimen/nui_espacio_s"
        android:paddingVertical="@dimen/biblio_marca_vertical"
        android:text="@string/marca_prestado"
        android:textAppearance="@style/TextAppearance.Nui.Etiqueta"
        android:textColor="@color/nui_granada"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/ivPortada"
        app:layout_constraintEnd_toEndOf="@id/ivPortada"
        app:layout_constraintStart_toStartOf="@id/ivPortada"
        app:layout_constraintTop_toTopOf="@id/ivPortada" />

    <TextView
        android:id="@+id/tvBasica"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/nui_espacio_xs"
        android:layout_marginTop="@dimen/nui_espacio_xs"
        android:background="@drawable/nui_marca_basica"
        android:importantForAccessibility="no"
        android:paddingHorizontal="@dimen/nui_espacio_xs"
        android:paddingVertical="@dimen/biblio_marca_vertical"
        android:text="@string/marca_basica"
        android:textAppearance="@style/TextAppearance.Nui.Etiqueta"
        android:textColor="@color/nui_arrayan"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/ivPortada"
        app:layout_constraintTop_toTopOf="@id/ivPortada" />
</androidx.constraintlayout.widget.ConstraintLayout>