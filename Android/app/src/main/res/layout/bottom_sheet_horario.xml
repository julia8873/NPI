<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/fondo_bottom_sheet"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Indicador superior de arrastre -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#D0D0D0" />

    <TextView
        android:id="@+id/tvBsHorarioTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🕒 Horario de Apertura"
        android:textColor="#000000"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvBsHorarioComedor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Comedor"
        android:textColor="#FF8C42"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvBsHorarioDia"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Fecha seleccionada"
        android:textColor="#666666"
        android:textSize="13sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="14dp"
        android:background="#EEEEEE" />

    <TextView
        android:id="@+id/tvBsHorarioDetalle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Horario: 13:00 - 16:30"
        android:textColor="#333333"
        android:textSize="16sp" />

</LinearLayout>

