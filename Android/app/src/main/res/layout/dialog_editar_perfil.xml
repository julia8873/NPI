<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/nombre_y_apellidos"
        android:textColor="#666666"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etDialogNombre"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_input_box"
        android:hint="@string/tu_nombre"
        android:paddingHorizontal="14dp"
        android:textColor="#1A1A1A"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/nueva_contrasena_opcional"
        android:textColor="#666666"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etDialogPassword"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_input_box"
        android:hint="@string/dejar_vacio_para_no_cambiar"
        android:inputType="textPassword"
        android:paddingHorizontal="14dp"
        android:textColor="#1A1A1A"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/grado_universitario"
        android:textColor="#666666"
        android:textSize="12sp"
        android:textStyle="bold" />

    <AutoCompleteTextView
        android:id="@+id/etDialogGrado"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_input_box"
        android:hint="@string/selecciona_tu_grado"
        android:paddingHorizontal="14dp"
        android:textColor="#1A1A1A"
        android:textSize="14sp" />

</LinearLayout>