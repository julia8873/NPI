<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nui_superficie"
    android:clipChildren="false">

    <LinearLayout
        android:id="@+id/contenidoMenu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <!-- 1. CABECERA: título · bola de inclinación · chat · perfil -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="18dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="-0.02"
                android:maxLines="1"
                android:text="NUI ETSIIT"
                android:textColor="@color/nui_tinta"
                android:textSize="19sp"
                android:textStyle="bold" />

            <com.example.nuietsiit.activities.main.NivelInclinacionView
                android:id="@+id/nivelInclinacion"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Indicador de inclinación. Toca para activar o desactivar."
                android:focusable="true" />

            <LinearLayout
                android:id="@+id/cardMascotaAyudante"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_nui_chat"
                android:clickable="true"
                android:contentDescription="Abrir asistente"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_nui_bot"
                    app:tint="@android:color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="Chat"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ivIcono"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_nui_circulo_suave"
                android:clickable="true"
                android:contentDescription="Perfil"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:padding="7dp"
                android:src="@drawable/ic_nui_usuario"
                app:tint="@color/nui_tinta" />
        </LinearLayout>

        <!-- 2. SLIDER DE NOTICIAS (Arriba, justo debajo de la cabecera) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginHorizontal="18dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeColor="#FFE3D1"
            app:strokeWidth="1dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/vpNoticias"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Badge cápsula: Novedades ETSIIT -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentBottom="true"
                    android:layout_margin="8dp"
                    app:cardBackgroundColor="#E6FFFFFF"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="1dp"
                    app:strokeColor="#FFD8BE"
                    app:strokeWidth="0.8dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="7dp"
                        android:paddingVertical="3dp">

                        <View
                            android:layout_width="5dp"
                            android:layout_height="5dp"
                            android:layout_marginEnd="5dp"
                            android:background="@drawable/circulo_dia_seleccionado"
                            android:backgroundTint="#FF8C42" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Novedades ETSIIT"
                            android:textColor="#0F172A"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3. TARJETA CALENDARIO / EVENTOS DE HOY (Arriba, debajo de noticias) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardEventoHoy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="18dp"
            android:layout_marginBottom="4dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@color/nui_suave"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp"
            app:strokeColor="#FFE3D1"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp">

                <TextView
                    android:id="@+id/tvHoraEvento"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_nui_etiqueta"
                    android:letterSpacing="0.04"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="HOY"
                    android:textColor="@color/nui_acento"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvTituloEventoHoy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Calendario de la ETSIIT"
                        android:textColor="@color/nui_tinta"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSubtituloEventoHoy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Actividades, citas, exámenes y entregas"
                        android:textColor="@color/nui_apagado"
                        android:textSize="10.5sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_nui_chevron_der"
                    app:tint="@color/nui_apagado" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 4. HUB 3x3 de fichas cuadradas (Con espacio superior respecto a las noticias/calendario) -->
        <com.example.nuietsiit.activities.main.HubSeccionesView
            android:id="@+id/hubSecciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="6dp" />

    </LinearLayout>

</FrameLayout>
