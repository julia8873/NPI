<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Cabecera: Texto de Bienvenida e Icono -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:paddingHorizontal="8dp">

            <TextView
                android:id="@+id/tvBienvenida"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/ivIcono"
                android:text="¡Bienvenido!"
                android:textColor="#000000"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivIcono"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:clickable="true"
                android:contentDescription="Icono de perfil"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:src="@drawable/icono" />
        </RelativeLayout>

        <!-- Contenedor del slide de Noticias -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginHorizontal="8dp"
            android:layout_marginTop="40dp">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/vpNoticias"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </FrameLayout>

        <!-- Cuadrícula con las 7 secciones principales -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:alignmentMode="alignMargins"
            android:columnCount="2"
            android:columnOrderPreserved="false"
            android:rowCount="4">

            <Button
                android:id="@+id/btnMapa"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_margin="8dp"
                android:layout_columnWeight="1"
                android:background="@drawable/boton_redondeado"
                android:text="Mapa"
                android:textColor="#FFFFFF"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btnActividades"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_margin="8dp"
                android:layout_columnWeight="1"
                android:background="@drawable/boton_redondeado"
                android:text="Actividades"
                android:textColor="#FFFFFF"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btnAsignaturas"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_margin="8dp"
                android:layout_columnWeight="1"
                android:background="@drawable/boton_redondeado"
                android:text="Asignaturas"
                android:textColor="#FFFFFF"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btnProfesorado"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_margin="8dp"
                android:layout_columnWeight="1"
                android:background="@drawable/boton_redondeado"
                android:text="Profesorado"
                android:textColor="#FFFFFF"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btnSecretaria"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_margin="8dp"
                android:layout_columnWeight="1"
                android:background="@drawable/boton_redondeado"
                android:text="Secretaría"
                android:textColor="#FFFFFF"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btnComedores"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_margin="8dp"
                android:layout_columnWeight="1"
                android:background="@drawable/boton_redondeado"
                android:text="Comedores"
                android:textColor="#FFFFFF"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btnBiblioteca"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_margin="8dp"
                android:layout_columnWeight="1"
                android:background="@drawable/boton_redondeado"
                android:text="Biblioteca"
                android:textColor="#FFFFFF"
                app:backgroundTint="@null" />

        </GridLayout>

    </LinearLayout>
</ScrollView>