<?xml version="1.0" encoding="utf-8"?>
<!-- Hoja que sube desde abajo con el anuncio completo (design system NUI) -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/nui_superficie">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/nui_espacio_l">

        <LinearLayout
            style="@style/Widget.Nui.Ficha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivIconoDetalle"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/nui_tesela"
                    android:importantForAccessibility="no"
                    android:padding="@dimen/nui_espacio_xs" />

                <TextView
                    android:id="@+id/tvCategoriaDetalle"
                    style="@style/Widget.Nui.Etiqueta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/nui_espacio_s" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvUrgenteDetalle"
                    style="@style/Widget.Nui.Sello"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Urgente"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTituloDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/nui_espacio_m"
                android:textAppearance="@style/TextAppearance.Nui.Titular" />

            <TextView
                android:id="@+id/tvFechaDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/nui_espacio_xs"
                android:textAppearance="@style/TextAppearance.Nui.Codigo" />

            <TextView
                android:id="@+id/tvContenidoDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/nui_espacio_m"
                android:textAppearance="@style/TextAppearance.Nui.Cuerpo" />

            <TextView
                android:id="@+id/tvCaducidadDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/nui_espacio_m"
                android:drawableStart="@drawable/nui_ic_reloj_arena"
                android:drawablePadding="@dimen/nui_espacio_s"
                android:drawableTint="@color/nui_granada"
                android:gravity="center_vertical"
                android:textAppearance="@style/TextAppearance.Nui.Cuerpo.Fuerte"
                android:textColor="@color/nui_granada"
                android:visibility="gone" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEnlace"
            style="@style/Widget.Nui.Boton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/nui_espacio_l"
            android:text="Abrir enlace"
            android:visibility="gone"
            app:icon="@drawable/ic_globe" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
