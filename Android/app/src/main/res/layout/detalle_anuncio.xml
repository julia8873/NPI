<?xml version="1.0" encoding="utf-8"?>
<!-- Hoja que sube desde abajo con el anuncio completo -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/sec_tarjeta">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivIconoDetalle"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/sec_circulo"
                android:importantForAccessibility="no"
                android:padding="8dp" />

            <TextView
                android:id="@+id/tvCategoriaDetalle"
                style="@style/Widget.Seccion.Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp" />

            <TextView
                android:id="@+id/tvUrgenteDetalle"
                style="@style/Widget.Seccion.Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:backgroundTint="@color/sec_error"
                android:text="@string/nui_not_urgente"
                android:textAllCaps="true"
                android:textColor="@android:color/white"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTituloDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAppearance="@style/TextAppearance.Seccion.Titulo" />

        <TextView
            android:id="@+id/tvFechaDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/TextAppearance.Seccion.Secundario" />

        <TextView
            android:id="@+id/tvContenidoDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="3dp"
            android:textAppearance="@style/TextAppearance.Seccion.Cuerpo" />

        <TextView
            android:id="@+id/tvCaducidadDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:drawableStart="@drawable/nui_ic_reloj_arena"
            android:drawablePadding="10dp"
            android:drawableTint="@color/sec_error"
            android:gravity="center_vertical"
            android:textColor="@color/sec_error"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEnlace"
            style="@style/Widget.Seccion.Boton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/nui_not_abrir_enlace"
            android:visibility="gone"
            app:icon="@drawable/ic_globe" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
