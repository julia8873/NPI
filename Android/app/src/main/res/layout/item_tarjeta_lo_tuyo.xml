<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta grande del inicio de Secretaría ("lo tuyo"): qué es y qué hacer con ella -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/nui_superficie"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/nui_linea"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="16dp"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/tvIcono"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/fondo_circulo"
            android:backgroundTint="@color/nui_tinte"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:textSize="26sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvEtiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:textAllCaps="true"
                android:textColor="@color/nui_apagado"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/nui_tinta"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetalle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/nui_apagado"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvAccion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/nui_acento"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Se puede tocar -->
        <TextView
            android:id="@+id/tvChevron"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="4dp"
            android:importantForAccessibility="no"
            android:paddingHorizontal="4dp"
            android:text="›"
            android:textColor="@color/nui_apagado"
            android:textSize="28sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
