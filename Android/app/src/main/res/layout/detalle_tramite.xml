<?xml version="1.0" encoding="utf-8"?>
<!-- Detalle de un trámite: su ficha de catálogo, los papeles con lo que hace falta y el siguiente paso. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nui_superficie"
    android:orientation="vertical">

    <!-- Cabecera de sala: yesería + arquería -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/nui_yeseria" />

    <com.example.nuietsiit.ui.TramaAzulejo
        android:layout_width="match_parent"
        android:layout_height="@dimen/nui_arqueria"
        android:importantForAccessibility="no"
        app:tesela="@drawable/nui_arqueria" />

    <com.example.nuietsiit.ui.HojasPaginadas
        android:id="@+id/hojas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/nui_espacio_l">

            <!-- Ficha del trámite: categoría en la cabecera, nombre, estado y descripción -->
            <LinearLayout
                style="@style/Widget.Nui.Ficha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCategoria"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:gravity="center_vertical"
                    android:textAppearance="@style/TextAppearance.Nui.Etiqueta" />

                <TextView
                    android:id="@+id/tvNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/nui_espacio_m"
                    android:textAppearance="@style/TextAppearance.Nui.Titular" />

                <TextView
                    android:id="@+id/tvEstado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/nui_espacio_s"
                    android:textAppearance="@style/TextAppearance.Nui.Etiqueta"
                    android:textAllCaps="false" />

                <TextView
                    android:id="@+id/tvDescripcion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/nui_espacio_m"
                    android:textAppearance="@style/TextAppearance.Nui.Cuerpo" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tarjetaRequisitos"
                style="@style/Widget.Nui.Papel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/nui_espacio_m"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:text="@string/requisitos"
                    android:textAppearance="@style/TextAppearance.Nui.Etiqueta" />

                <TextView
                    android:id="@+id/tvRequisitos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/nui_espacio_xs"
                    android:textAppearance="@style/TextAppearance.Nui.Cuerpo" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tarjetaPlazos"
                style="@style/Widget.Nui.Papel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/nui_espacio_m"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:text="@string/plazos"
                    android:textAppearance="@style/TextAppearance.Nui.Etiqueta" />

                <TextView
                    android:id="@+id/tvPlazos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/nui_espacio_xs"
                    android:textAppearance="@style/TextAppearance.Nui.Cuerpo" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tarjetaDocumentos"
                style="@style/Widget.Nui.Papel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/nui_espacio_m"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:text="@string/documentos_necesitas"
                    android:textAppearance="@style/TextAppearance.Nui.Etiqueta" />

                <LinearLayout
                    android:id="@+id/llDocumentos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Los pasos, uno a uno (PasosTramite) -->
            <LinearLayout
                android:id="@+id/btnPasos"
                style="@style/Widget.Nui.Papel.Pulsable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/nui_espacio_m"
                android:gravity="center_vertical"
                android:minHeight="@dimen/nui_toque_min"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPasos"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.Nui.Cuerpo.Fuerte" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:text="›"
                    android:textColor="@color/nui_apagado"
                    android:textSize="@dimen/nui_texto_xl" />
            </LinearLayout>
        </LinearLayout>
    </com.example.nuietsiit.ui.HojasPaginadas>

    <!-- Siguiente paso: un solo botón grande, siempre a la vista, sobre el mostrador -->
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/nui_borde"
        android:background="@color/nui_papel_sombra" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/nui_suave"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/nui_espacio_l"
        android:paddingTop="@dimen/nui_espacio_m"
        android:paddingBottom="@dimen/nui_espacio_xs">

        <TextView
            android:id="@+id/tvMotivoSolicitar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/nui_espacio_s"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Nui.Cuerpo.Secundario"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSiguiente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAlternativa"
            style="@style/Widget.Nui.Boton.Texto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- Zócalo: filete de oro + alicatado -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/nui_oro" />

    <com.example.nuietsiit.ui.TramaAzulejo
        android:layout_width="match_parent"
        android:layout_height="@dimen/nui_zocalo"
        android:importantForAccessibility="no" />
</LinearLayout>