<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Cabecera -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:paddingHorizontal="8dp">

        <TextView
            android:id="@+id/tvAsignaturas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/ivIcono"
            android:text="Asignaturas"
            android:textColor="#000000"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivIcono"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:clickable="true"
            android:contentDescription="Icono de perfil"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:src="@drawable/icono" />
    </RelativeLayout>

    <!-- Recuadro expansible para el horario/estado del usuario -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardHorario"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="24dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#F5F5F5">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <!-- 1. VISTA SIN SESIÓN INICIADA -->
            <LinearLayout
                android:id="@+id/layoutLoggedOut"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="No has iniciado sesión aún.\nPara ver tu horario accede con tus credenciales."
                    android:textColor="#666666"
                    android:textSize="15sp"
                    android:layout_marginHorizontal="16dp"/>

                <Button
                    android:id="@+id/btnLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Iniciar sesión" />
            </LinearLayout>

            <!-- 2. VISTA CON SESIÓN INICIADA (Horario Semanal) -->
            <LinearLayout
                android:id="@+id/layoutLoggedIn"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvUserWelcome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tu horario semanal:"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <!-- Doble Scroll para la cuadrícula -->
                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <HorizontalScrollView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:fillViewport="true">

                        <!-- La tabla que llenaremos desde la BD -->
                        <TableLayout
                            android:id="@+id/tablaHorario"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:stretchColumns="*">
                        </TableLayout>

                    </HorizontalScrollView>
                </ScrollView>
            </LinearLayout>

        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <!-- EL BOTÓN PARA LA RUETA INTERACTIVA -->
    <Button
        android:id="@+id/btnVerMasAsignaturas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="10dp"
        android:padding="16dp"
        android:text="¿Quieres ver más asignaturas?"
        android:textSize="16sp"
        app:cornerRadius="24dp" />

</LinearLayout>