<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootAsignaturas"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:orientation="vertical">

    <!-- CABECERA UNIFICADA: Botón volver · Título · Chat · Perfil -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <ImageButton
            android:id="@+id/btnVolver"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_circulo_blanco_volver"
            android:contentDescription="Volver al menú principal"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_chevron_left"
            app:tint="@color/nui_tinta" />

        <TextView
            android:id="@+id/tvTituloSeccion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:letterSpacing="-0.02"
            android:maxLines="1"
            android:text="@string/sec_titulo"
            android:textColor="@color/nui_tinta"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/cardMascotaAyudante"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_nui_chat"
            android:clickable="true"
            android:contentDescription="Abrir asistente"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_nui_bot"
                app:tint="@android:color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Chat"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivIcono"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_nui_circulo_suave"
            android:clickable="true"
            android:contentDescription="Perfil"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_nui_usuario"
            app:tint="@color/nui_tinta" />
    </LinearLayout>

    <!-- Todo cabe en pantalla, sin scroll: «lo tuyo» ocupa el hueco libre (las tarjetas que no caben
         se quitan en Secretaria.recortarLoTuyo) y el catálogo, al abrirlo, ocupa ese hueco y el del mostrador -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/nui_espacio_l"
        android:paddingTop="@dimen/nui_espacio_s">

        <!-- Lo tuyo: tarjetas según tu situación (se rellenan en Secretaria.mostrarLoTuyo) -->
        <LinearLayout
            android:id="@+id/contenedorLoTuyo"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical" />

        <!-- Catálogo completo, escondido hasta que se pide: sube como un cajón -->
        <LinearLayout
            android:id="@+id/grupoCatalogo"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_buscar_tramite"
                app:boxBackgroundColor="#FFFFFF"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="#FF8C42"
                app:hintEnabled="false"
                app:startIconDrawable="@android:drawable/ic_menu_search"
                app:startIconTint="@color/nui_apagado">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etBuscar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_buscar_tramite"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:textAppearance="@style/TextAppearance.Nui.Cuerpo"
                    android:textColorHint="@color/nui_apagado" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Separadores del fichero: pestañas de papel con icono y nombre, todas a la vista
                 (se crean en Secretaria.crearPestanas) -->
            <com.example.nuietsiit.ui.PestanasPapel
                android:id="@+id/pestanasCategorias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/nui_espacio_s" />

            <TextView
                android:id="@+id/tvMostrandoPara"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/nui_espacio_s"
                android:textAppearance="@style/TextAppearance.Nui.Cuerpo.Secundario"
                android:visibility="gone" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSugerencia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <!-- Cajón del fichero: tarjeta con las fichas de trámite, sin scroll: se pasan deslizando de lado -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/nui_espacio_s"
                android:layout_weight="1"
                android:background="@drawable/nui_cajon"
                android:clipChildren="true">

                <com.example.nuietsiit.activities.secciones.secretaria.FicheroPaginado
                    android:id="@+id/fichero"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="@dimen/nui_espacio_s"
                    android:paddingTop="@dimen/nui_espacio_s"
                    android:paddingBottom="@dimen/nui_espacio_m" />

                <TextView
                    android:id="@+id/tvVacio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/nui_espacio_xl"
                    android:gravity="center"
                    android:text="@string/no_hay_tramites_coincidentes"
                    android:textAppearance="@style/TextAppearance.Nui.Cuerpo.Secundario"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Pasar fichas también con flechas (accesible sin el gesto) -->
            <LinearLayout
                android:id="@+id/grupoPaginas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/btnFichasAtras"
                    android:layout_width="@dimen/nui_toque_min"
                    android:layout_height="@dimen/nui_toque_min"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/fichas_anteriores"
                    android:gravity="center"
                    android:text="‹"
                    android:textAppearance="@style/TextAppearance.Nui.Titular.M"
                    android:textColor="#FF8C42" />

                <TextView
                    android:id="@+id/tvPagina"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/nui_espacio_s"
                    android:accessibilityLiveRegion="polite"
                    android:textAppearance="@style/TextAppearance.Nui.Cuerpo.Secundario" />

                <TextView
                    android:id="@+id/btnFichasAdelante"
                    android:layout_width="@dimen/nui_toque_min"
                    android:layout_height="@dimen/nui_toque_min"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/fichas_siguientes"
                    android:gravity="center"
                    android:text="›"
                    android:textAppearance="@style/TextAppearance.Nui.Titular.M"
                    android:textColor="#FF8C42" />
            </LinearLayout>
        </LinearLayout>

        <!-- Tres objetos de mostrador: la rosa (te orienta), el turno (cita) y la carpeta (lo tuyo) -->
        <LinearLayout
            android:id="@+id/grupoMostrador"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/nui_espacio_s"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btnQueNecesitas"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/nui_papel_seleccionado"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_horizontal"
                android:minHeight="128dp"
                android:orientation="vertical"
                android:padding="@dimen/nui_espacio_m">

                <ImageView
                    android:layout_width="@dimen/nui_icono_objeto"
                    android:layout_height="@dimen/nui_icono_objeto"
                    android:importantForAccessibility="no"
                    android:src="@drawable/nui_rosa_vientos" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/nui_espacio_s"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/que_necesitas"
                    android:textAppearance="@style/TextAppearance.Nui.Cuerpo.Fuerte" />
            </LinearLayout>

            <Space
                android:layout_width="@dimen/nui_espacio_s"
                android:layout_height="0dp" />

            <LinearLayout
                android:id="@+id/btnPedirCita"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/nui_papel_estado"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_horizontal"
                android:minHeight="128dp"
                android:orientation="vertical"
                android:padding="@dimen/nui_espacio_m">

                <FrameLayout
                    android:layout_width="@dimen/nui_icono_objeto"
                    android:layout_height="@dimen/nui_icono_objeto"
                    android:importantForAccessibility="no">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/nui_turno" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="14dp"
                        android:text="A27"
                        android:textAppearance="@style/TextAppearance.Nui.Codigo"
                        android:textColor="#FF8C42" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/nui_espacio_s"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/pedir_cita"
                    android:textAppearance="@style/TextAppearance.Nui.Cuerpo.Fuerte" />
            </LinearLayout>

            <Space
                android:layout_width="@dimen/nui_espacio_s"
                android:layout_height="0dp" />

            <LinearLayout
                android:id="@+id/btnMisGestiones"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/nui_papel_estado"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_horizontal"
                android:minHeight="128dp"
                android:orientation="vertical"
                android:padding="@dimen/nui_espacio_m">

                <ImageView
                    android:layout_width="@dimen/nui_icono_objeto"
                    android:layout_height="@dimen/nui_icono_objeto"
                    android:importantForAccessibility="no"
                    android:src="@drawable/nui_carpeta" />

                <TextView
                    android:id="@+id/tvMisGestiones"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/nui_espacio_s"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/mis_gestiones"
                    android:textAppearance="@style/TextAppearance.Nui.Cuerpo.Fuerte" />
            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/tvVerTodos"
            android:layout_width="match_parent"
            android:layout_height="@dimen/nui_toque_min"
            android:layout_marginTop="@dimen/nui_espacio_xs"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:text="@string/ver_todos_los_tramites"
            android:textAppearance="@style/TextAppearance.Nui.Cuerpo.Fuerte"
            android:textColor="#FF8C42" />
    </LinearLayout>

</LinearLayout>
