<?xml version="1.0" encoding="utf-8"?>
<!-- Actividades (design system NUI, como Secretaría y Biblioteca): yesería + arquería, pestañas de papel
     con los tipos, un mazo de fichas (una cada vez, sin scroll) y la botonera. Zócalo abajo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nui_superficie"
    android:orientation="vertical">

    <!-- Cabecera de sala: yesería + arquería -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/nui_yeseria"
        app:titleTextAppearance="@style/TextAppearance.Nui.Titular" />

    <com.example.nuietsiit.ui.TramaAzulejo
        android:layout_width="match_parent"
        android:layout_height="@dimen/nui_arqueria"
        android:importantForAccessibility="no"
        app:tesela="@drawable/nui_arqueria" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/nui_espacio_l"
        android:paddingTop="@dimen/nui_espacio_m"
        android:paddingBottom="@dimen/nui_espacio_s">

        <!-- Tipos de actividad: pestañas de papel, todas a la vista (se crean en Actividades.crearPestanas) -->
        <com.example.nuietsiit.ui.PestanasPapel
            android:id="@+id/pestanasTipos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- El mazo: la ficha de arriba se arrastra; los sellos aparecen al moverla -->
        <FrameLayout
            android:id="@+id/zonaMazo"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/nui_espacio_m"
            android:layout_weight="1"
            android:clipChildren="false">

            <LinearLayout
                android:id="@+id/carta"
                style="@style/Widget.Nui.Ficha"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical">

                <!-- Cabecera de la ficha (sobre la línea granada): tipo y cuándo -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvTipoCarta"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.Nui.Etiqueta" />

                    <TextView
                        android:id="@+id/tvCuandoCarta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Nui.Codigo" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/nui_espacio_m"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Tesela con el icono del tipo (color y tinte por código) -->
                    <ImageView
                        android:id="@+id/ivIconoCarta"
                        android:layout_width="@dimen/nui_icono_objeto"
                        android:layout_height="@dimen/nui_icono_objeto"
                        android:background="@drawable/nui_tesela"
                        android:importantForAccessibility="no"
                        android:padding="@dimen/nui_espacio_s" />

                    <TextView
                        android:id="@+id/tvTituloCarta"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/nui_espacio_m"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="3"
                        android:textAppearance="@style/TextAppearance.Nui.Titular" />
                </LinearLayout>

                <!-- Solo AbiertaUGR: créditos y estado del plazo -->
                <TextView
                    android:id="@+id/tvExtraCarta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/nui_espacio_s"
                    android:textAppearance="@style/TextAppearance.Nui.Cuerpo.Fuerte"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvDescCarta"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/nui_espacio_m"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:textAppearance="@style/TextAppearance.Nui.Cuerpo" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/nui_espacio_s"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Toca la ficha para ver los detalles"
                        android:textAppearance="@style/TextAppearance.Nui.Cuerpo.Secundario" />

                    <!-- Ya inscrito: sello de arrayán -->
                    <TextView
                        android:id="@+id/tvInscritoCarta"
                        style="@style/Widget.Nui.Sello"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:backgroundTint="@color/nui_arrayan"
                        android:text="Apuntado"
                        android:textColor="@color/nui_arrayan"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <!-- Sellos que se ven al arrastrar o inclinar (alpha por código) -->
            <TextView
                android:id="@+id/selloSi"
                style="@style/Widget.Nui.Sello"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_marginStart="@dimen/nui_espacio_l"
                android:layout_marginTop="@dimen/nui_espacio_xxl"
                android:alpha="0"
                android:backgroundTint="@color/nui_arrayan"
                android:importantForAccessibility="no"
                android:text="Me apunto"
                android:textColor="@color/nui_arrayan"
                android:textSize="@dimen/nui_texto_l" />

            <TextView
                android:id="@+id/selloNo"
                style="@style/Widget.Nui.Sello"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginTop="@dimen/nui_espacio_xxl"
                android:layout_marginEnd="@dimen/nui_espacio_l"
                android:alpha="0"
                android:importantForAccessibility="no"
                android:rotation="6"
                android:text="Paso"
                android:textSize="@dimen/nui_texto_l" />

            <!-- Sin fichas: no hay de este tipo, o ya se han visto todas -->
            <LinearLayout
                android:id="@+id/vacio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvVacio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.Nui.Titular.M" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReiniciar"
                    style="@style/Widget.Nui.Boton.Secundario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/nui_espacio_l"
                    android:text="Volver a verlas" />
            </LinearLayout>
        </FrameLayout>

        <!-- Botonera: pasar, apuntarse (el principal) y volver a la anterior -->
        <LinearLayout
            android:id="@+id/botonera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/nui_espacio_m"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAnterior"
                style="@style/Widget.Nui.Boton.Texto"
                android:layout_width="@dimen/nui_toque_min"
                android:layout_height="@dimen/nui_toque_min"
                android:contentDescription="Volver a la anterior"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:padding="0dp"
                app:icon="@drawable/ic_arrow_back"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPasar"
                style="@style/Widget.Nui.Boton.Secundario"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/nui_espacio_s"
                android:layout_weight="1"
                android:text="Paso" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApuntar"
                style="@style/Widget.Nui.Boton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/nui_espacio_s"
                android:layout_weight="1"
                android:text="Me apunto" />

            <!-- Órdenes por voz: "paso", "me apunto", "llévame"... (Actividades.escucharOrden) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVoz"
                style="@style/Widget.Nui.Boton.Texto"
                android:layout_width="@dimen/nui_toque_min"
                android:layout_height="@dimen/nui_toque_min"
                android:layout_marginStart="@dimen/nui_espacio_xs"
                android:contentDescription="Dar una orden por voz"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:padding="0dp"
                app:icon="@drawable/nui_ic_microfono"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvContador"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityLiveRegion="polite"
                android:textAppearance="@style/TextAppearance.Nui.Codigo" />

            <!-- Escanear el QR del cartel de una actividad (cámara) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEscanear"
                style="@style/Widget.Nui.Boton.Texto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Escanear el QR de un cartel"
                android:text="Escanear"
                app:icon="@drawable/nui_ic_escaner" />

            <!-- Grupos de chat (WhatsApp/Telegram/Discord simulados) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnComunidades"
                style="@style/Widget.Nui.Boton.Texto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Comunidades de chat"
                android:text="Grupos"
                app:icon="@drawable/nui_ic_movil" />
        </LinearLayout>
    </LinearLayout>

    <!-- Zócalo: filete de oro + alicatado -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/nui_oro" />

    <com.example.nuietsiit.ui.TramaAzulejo
        android:layout_width="match_parent"
        android:layout_height="@dimen/nui_zocalo"
        android:importantForAccessibility="no" />
</LinearLayout>
