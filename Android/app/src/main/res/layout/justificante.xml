<?xml version="1.0" encoding="utf-8"?>
<!-- Justificante: resguardo de papel. Arriba los datos, troquel, y abajo la matriz con el QR. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/contenido"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nui_superficie"
    android:orientation="vertical">

    <!-- Cabecera de sala: yesería + arquería -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/nui_yeseria" />

    <com.example.nuietsiit.ui.TramaAzulejo
        android:layout_width="match_parent"
        android:layout_height="@dimen/nui_arqueria"
        android:importantForAccessibility="no"
        app:tesela="@drawable/nui_arqueria" />

    <!-- clipChildren="false": el QR ampliado con pinch puede salirse de su sitio (lo recorta la pantalla) -->
    <com.example.nuietsiit.ui.HojasPaginadas
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/nui_espacio_l">

            <!-- El resguardo -->
            <LinearLayout
                style="@style/Widget.Nui.Papel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Resguardo · Secretaría ETSIIT"
                    android:textAppearance="@style/TextAppearance.Nui.Etiqueta" />

                <!-- Número del resguardo, como un número de turno -->
                <TextView
                    android:id="@+id/tvCodigo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/nui_espacio_s"
                    android:accessibilityHeading="true"
                    android:textAppearance="@style/TextAppearance.Nui.Codigo"
                    android:textColor="@color/nui_granada"
                    android:textSize="@dimen/nui_texto_l" />

                <TextView
                    android:id="@+id/tvMotivo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/nui_espacio_m"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.Nui.Titular.M" />

                <TextView
                    android:id="@+id/tvFecha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/nui_espacio_s"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.Nui.Cuerpo" />

                <TextView
                    android:id="@+id/tvHora"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Nui.Titular.XL" />

                <!-- Cancelada / pasada / estado de la solicitud: sello estampado -->
                <TextView
                    android:id="@+id/tvEstado"
                    style="@style/Widget.Nui.Sello"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/nui_espacio_m"
                    android:visibility="gone" />

                <!-- Troquel: aquí empieza la matriz que se enseña en ventanilla -->
                <View
                    style="@style/Widget.Nui.Troquel"
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/nui_espacio_l" />

                <!-- el contenedor recibe los toques del pinch: el QR ampliado no altera sus coordenadas -->
                <FrameLayout
                    android:id="@+id/flQR"
                    android:layout_width="240dp"
                    android:layout_height="240dp"
                    android:layout_marginTop="@dimen/nui_espacio_l"
                    android:clipChildren="false"
                    android:translationZ="8dp">

                    <ImageView
                        android:id="@+id/ivQR"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/nui_superficie"
                        android:scaleType="fitCenter" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvAyudaQR"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/nui_espacio_m"
                    android:gravity="center"
                    android:text="Gira el móvil hacia la ventanilla de Secretaría, o toca el código, para enseñarlo a pantalla completa.\nPellizca para ampliarlo; doble toque para volver."
                    android:textAppearance="@style/TextAppearance.Nui.Cuerpo.Secundario" />
            </LinearLayout>

            <!-- Resguardo con línea perforada (solo citas vigentes): rasgarlo cancela la cita -->
            <com.example.nuietsiit.activities.secciones.secretaria.ResguardoRasgable
                android:id="@+id/resguardo"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="-6dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvAvisoCalendario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/nui_espacio_l"
                android:gravity="center"
                android:text="Has cambiado la cita: actualiza también tu calendario"
                android:textAppearance="@style/TextAppearance.Nui.Cuerpo.Fuerte"
                android:textColor="@color/nui_error"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalendario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/nui_espacio_m"
                android:text="Añadir al calendario"
                android:visibility="gone"
                app:icon="@drawable/nui_ic_cita" />
        </LinearLayout>
    </com.example.nuietsiit.ui.HojasPaginadas>

    <!-- Zócalo: filete de oro + alicatado -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/nui_oro" />

    <com.example.nuietsiit.ui.TramaAzulejo
        android:layout_width="match_parent"
        android:layout_height="@dimen/nui_zocalo"
        android:importantForAccessibility="no" />
</LinearLayout>
