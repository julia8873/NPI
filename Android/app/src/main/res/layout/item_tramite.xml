<?xml version="1.0" encoding="utf-8"?>
<!-- Ficha de trámite del fichero: tarjeta blanca con la categoría arriba -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/itemTramite"
    style="@style/Widget.Nui.Ficha"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/nui_espacio_xs"
    android:layout_marginBottom="2dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvCategoria"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:gravity="center_vertical"
        android:textAppearance="@style/TextAppearance.Nui.Etiqueta" />

    <TextView
        android:id="@+id/tvNombre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/nui_espacio_s"
        android:textAppearance="@style/TextAppearance.Nui.Titular.M" />

    <TextView
        android:id="@+id/chipPlazo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/nui_espacio_xs"
        android:text="@string/plazo_abierto"
        android:textAppearance="@style/TextAppearance.Nui.Cuerpo.Fuerte"
        android:textColor="#FF8C42"
        android:textSize="@dimen/nui_texto_s" />
</LinearLayout>