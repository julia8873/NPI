<?xml version="1.0" encoding="utf-8"?>
<!-- Panel inferior deslizable de "Cómo llegar" (rutas exteriores a pie y en bus). Lo maneja PanelRutaExterior. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/panelRutaExterior"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/sheetRutaExterior"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:behavior_hideable="true"
        app:behavior_peekHeight="196dp"
        app:cardBackgroundColor="#FFFBF7"
        app:cardElevation="10dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:cardCornerRadius="24dp"
        app:strokeColor="#FFE7D6"
        app:strokeWidth="1.5dp">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingBottom="16dp">

                <!-- Asa para deslizar -->
                <View
                    android:layout_width="36dp"
                    android:layout_height="4dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:background="@color/nui_linea" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvRutaExtTitulo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:minHeight="48dp"
                        android:gravity="center_vertical"
                        android:text="Cómo llegar"
                        android:textColor="@color/nui_apagado"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnRutaExtAyuda"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Cómo funciona"
                        android:padding="12dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_help"
                        app:tint="@color/nui_apagado" />

                    <ImageButton
                        android:id="@+id/btnRutaExtCerrar"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Cerrar"
                        android:padding="6dp"
                        android:src="@android:drawable/ic_menu_close_clear_cancel"
                        app:tint="@color/nui_apagado" />
                </LinearLayout>

                <include layout="@layout/guia_ruta_exterior" />

                <!-- Resumen y botones (se esconden mientras la guía está activa) -->
                <LinearLayout
                    android:id="@+id/llRutaExtResumen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Resumen: "Llegas a las 8:57" + "18 min · sal en 3 min (8:39)" -->
                    <TextView
                        android:id="@+id/tvRutaExtLlegada"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/nui_tinta"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvRutaExtSalida"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/nui_acento"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRutaExtEmpezar"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1.4"
                            android:backgroundTint="@color/nui_acento"
                            android:enabled="false"
                            android:text="Empezar guía"
                            android:textAllCaps="false"
                            android:textColor="@android:color/white"
                            android:textStyle="bold"
                            app:cornerRadius="14dp"
                            app:icon="@android:drawable/ic_menu_directions"
                            app:iconTint="@android:color/white" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRutaExtMaps"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:backgroundTint="@color/nui_suave"
                            android:text="Google Maps"
                            android:textAllCaps="false"
                            android:textColor="@color/nui_tinta"
                            android:textStyle="bold"
                            app:cornerRadius="14dp"
                            app:strokeColor="#FFE3D1"
                            app:strokeWidth="1dp" />
                    </LinearLayout>

                </LinearLayout>

                <!-- Elegir origen, destino y bus (se esconde mientras la guía está activa) -->
                <LinearLayout
                    android:id="@+id/llRutaExtElegir"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Desde / Hasta (chips creados por código a partir de los lugares de la red) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Desde"
                        android:textColor="@color/nui_apagado"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipsRutaExtDesde"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:selectionRequired="true"
                            app:singleLine="true"
                            app:singleSelection="true" />
                    </HorizontalScrollView>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="👆 Mantén pulsado el mapa para salir desde cualquier otro punto."
                        android:textColor="@color/nui_apagado"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Hasta"
                        android:textColor="@color/nui_apagado"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipsRutaExtHasta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:selectionRequired="true"
                            app:singleLine="true"
                            app:singleSelection="true" />
                    </HorizontalScrollView>

                    <TextView
                        android:id="@+id/tvRutaExtPista"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/nui_apagado"
                        android:textSize="12sp" />

                    <!-- Bus anterior / elegido / siguientes -->
                    <TextView
                        android:id="@+id/tvRutaExtOtrosBuses"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Otros buses"
                        android:textColor="@color/nui_apagado"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <HorizontalScrollView
                        android:id="@+id/scrollRutaExtAlternativas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipsRutaExtAlternativas"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:selectionRequired="true"
                            app:singleLine="true"
                            app:singleSelection="true" />
                    </HorizontalScrollView>

                </LinearLayout>

                <!-- Línea de tiempo: una fila por tramo -->
                <LinearLayout
                    android:id="@+id/llRutaExtPasos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </com.google.android.material.card.MaterialCardView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
