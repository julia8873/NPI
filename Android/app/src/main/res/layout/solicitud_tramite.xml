<?xml version="1.0" encoding="utf-8"?>
<!-- Expediente físico: documentos sobre la mesa → carpeta → firma → sello → lanzar para enviar -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:clipChildren="false"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#FFFFFF"
        app:titleTextColor="#000000" />

    <!-- Progreso: "Paso 1 de 4 · Documentos" -->
    <TextView
        android:id="@+id/tvPaso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:letterSpacing="0.08"
        android:textAllCaps="true"
        android:textColor="@color/nui_apagado"
        android:textSize="12sp"
        android:textStyle="bold" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progreso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="6dp"
        android:max="4"
        app:indicatorColor="@color/nui_acento"
        app:trackColor="@color/nui_linea"
        app:trackCornerRadius="4dp"
        app:trackThickness="6dp" />

    <!-- Qué hacer ahora, en una frase -->
    <TextView
        android:id="@+id/tvInstruccion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:accessibilityLiveRegion="polite"
        android:textColor="@color/nui_tinta"
        android:textSize="21sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvAyuda"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:textColor="@color/nui_apagado"
        android:textSize="14sp" />

    <!-- La mesa: documentos todavía fuera de la carpeta -->
    <HorizontalScrollView
        android:id="@+id/mesaScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingHorizontal="10dp"
        android:scrollbars="none">

        <!-- centrada si caben todas; si no, se desplaza -->
        <LinearLayout
            android:id="@+id/mesa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:paddingVertical="8dp" />
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false">

        <TextView
            android:id="@+id/tvFlecha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="4dp"
            android:importantForAccessibility="no"
            android:text="⬆"
            android:textColor="@color/nui_acento"
            android:textSize="40sp"
            android:visibility="gone" />

        <!-- La carpeta -->
        <FrameLayout
            android:id="@+id/carpeta"
            android:layout_width="match_parent"
            android:layout_height="380dp"
            android:layout_gravity="bottom"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="12dp"
            android:clipChildren="false">

            <View
                android:layout_width="110dp"
                android:layout_height="40dp"
                android:background="@drawable/fondo_carpeta_trasera" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="22dp"
                android:background="@drawable/fondo_carpeta_trasera" />

            <!-- Hojas ya metidas, asomando por arriba -->
            <LinearLayout
                android:id="@+id/papeles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="36dp"
                android:gravity="center_horizontal"
                android:orientation="horizontal" />

            <!-- Mientras no hay hojas: dónde soltar los documentos -->
            <TextView
                android:id="@+id/zonaSoltar"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="34dp"
                android:background="@drawable/fondo_zona_soltar"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:text="⬇  Suelta aquí los documentos"
                android:textColor="#7A5420"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Tapa delantera: se estira hasta arriba al cerrarse -->
            <FrameLayout
                android:id="@+id/tapa"
                android:layout_width="match_parent"
                android:layout_height="230dp"
                android:layout_gravity="bottom"
                android:background="@drawable/fondo_carpeta_tapa"
                android:elevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Etiqueta de papel pegada en la tapa -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/fondo_papel"
                        android:elevation="1dp"
                        android:orientation="vertical"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="8dp">

                        <TextView
                            android:id="@+id/tvTituloCarpeta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/nui_tinta"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvContador"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:accessibilityLiveRegion="polite"
                            android:textColor="@color/nui_apagado"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Firma (con la carpeta cerrada) -->
                    <LinearLayout
                        android:id="@+id/zonaFirma"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="150dp">

                            <com.example.nuietsiit.util.LienzoFirma
                                android:id="@+id/lienzoFirma"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/fondo_firma"
                                android:contentDescription="Recuadro para firmar con el dedo" />

                            <TextView
                                android:id="@+id/tvFirmaAqui"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:text="✍ Firma aquí"
                                android:textColor="#BBBBBB"
                                android:textSize="16sp" />

                            <TextView
                                android:id="@+id/tvFirmadoHuella"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/fondo_papel"
                                android:gravity="center"
                                android:text="🔒 Firmado con tu huella"
                                android:textColor="@color/nui_tinta"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:visibility="gone" />
                        </FrameLayout>

                        <LinearLayout
                            android:id="@+id/botonesFirma"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/btnBorrarFirma"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="20dp"
                                android:minWidth="0dp"
                                android:paddingHorizontal="0dp"
                                android:text="✕ Borrar firma"
                                android:textColor="#7A5420" />

                            <Button
                                android:id="@+id/btnFirmarHuella"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minWidth="0dp"
                                android:paddingHorizontal="0dp"
                                android:text="👆 Usar mi huella"
                                android:textColor="#7A5420"
                                android:visibility="gone" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvNota"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginTop="4dp"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textColor="#7A5420"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Sello: mantener el dedo hasta el "clac" -->
                <FrameLayout
                    android:id="@+id/sello"
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/fondo_sello"
                    android:clickable="true"
                    android:contentDescription="Sello: mantén el dedo para sellar"
                    android:elevation="3dp"
                    android:focusable="true"
                    android:visibility="gone">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/anilloSello"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:max="1000"
                        app:indicatorColor="#C62828"
                        app:indicatorInset="0dp"
                        app:indicatorSize="84dp"
                        app:trackColor="#33C62828"
                        app:trackThickness="6dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center_horizontal"
                        android:importantForAccessibility="no"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔏"
                            android:textSize="26sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.06"
                            android:text="MANTÉN"
                            android:textColor="#C62828"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>

                <!-- Marca que deja el sello -->
                <TextView
                    android:id="@+id/marcaSello"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="18dp"
                    android:background="@drawable/fondo_marca_sello"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:rotation="-12"
                    android:textColor="#C62828"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Encima de todo al final: arrastrar la carpeta hacia arriba -->
            <View
                android:id="@+id/capaLanzar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="true"
                android:contentDescription="Carpeta sellada: lánzala hacia arriba para enviar"
                android:elevation="6dp"
                android:focusable="true"
                android:visibility="gone" />
        </FrameLayout>
    </FrameLayout>

    <Button
        android:id="@+id/btnCerrarCarpeta"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="16dp"
        android:text="Cerrar la carpeta sin los opcionales"
        android:textColor="@color/nui_acento"
        android:visibility="gone" />

    <!-- Con la carpeta cerrada: volver a abrirla para ver o cambiar los documentos -->
    <Button
        android:id="@+id/btnAbrirCarpeta"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="16dp"
        android:text="📂 Abrir la carpeta para revisar los documentos"
        android:textColor="@color/nui_apagado"
        android:visibility="gone" />

    <!-- Alternativa sin gesto: aparece unos segundos después de sellar -->
    <Button
        android:id="@+id/btnEnviar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/boton_redondeado"
        android:text="Enviar sin lanzar"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:visibility="gone"
        app:backgroundTint="@null" />
</LinearLayout>
