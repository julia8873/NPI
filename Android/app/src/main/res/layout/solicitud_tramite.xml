<?xml version="1.0" encoding="utf-8"?>
<!-- Expediente físico: documentos sobre la mesa → carpeta → firma → sello → lanzar para enviar -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nui_superficie"
    android:clipChildren="false"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/nui_yeseria" />

    <!-- Arquería bajo la cabecera de yesería. Sin zócalo: aquí la carpeta necesita todo el alto -->
    <com.example.nuietsiit.ui.TramaAzulejo
        android:layout_width="match_parent"
        android:layout_height="@dimen/nui_arqueria"
        android:importantForAccessibility="no"
        app:tesela="@drawable/nui_arqueria" />

    <!-- Progreso: "Paso 1 de 4 · Documentos" -->
    <TextView
        android:id="@+id/tvPaso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/nui_espacio_l"
        android:layout_marginTop="@dimen/nui_espacio_s"
        android:textAppearance="@style/TextAppearance.Nui.Etiqueta" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progreso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/nui_espacio_l"
        android:layout_marginTop="@dimen/nui_espacio_xs"
        android:max="4"
        app:indicatorColor="@color/nui_resaltado"
        app:trackColor="@color/nui_papel_sombra"
        app:trackCornerRadius="0dp"
        app:trackThickness="@dimen/nui_espacio_s" />

    <!-- Qué hacer ahora, en una frase -->
    <TextView
        android:id="@+id/tvInstruccion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/nui_espacio_l"
        android:layout_marginTop="@dimen/nui_espacio_m"
        android:accessibilityLiveRegion="polite"
        android:textAppearance="@style/TextAppearance.Nui.Titular.M" />

    <TextView
        android:id="@+id/tvAyuda"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/nui_espacio_l"
        android:layout_marginTop="@dimen/nui_espacio_xs"
        android:textAppearance="@style/TextAppearance.Nui.Cuerpo.Secundario" />

    <!-- La mesa: documentos todavía fuera de la carpeta -->
    <FrameLayout
        android:id="@+id/mesaScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/nui_espacio_m"
        android:clipToPadding="false"
        android:paddingHorizontal="10dp"
        android:clipChildren="false">

        <!-- centrada; si no caben, las tarjetas se estrechan (SolicitudTramite.ajustarMesa) -->
        <LinearLayout
            android:id="@+id/mesa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:paddingVertical="@dimen/nui_espacio_s" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false">

        <TextView
            android:id="@+id/tvFlecha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="4dp"
            android:importantForAccessibility="no"
            android:text="↑"
            android:textAppearance="@style/TextAppearance.Nui.Titular.XL"
            android:textColor="@color/nui_acento_profundo"
            android:visibility="gone" />

        <!-- La carpeta -->
        <FrameLayout
            android:id="@+id/carpeta"
            android:layout_width="match_parent"
            android:layout_height="380dp"
            android:layout_gravity="bottom"
            android:layout_marginHorizontal="@dimen/nui_espacio_l"
            android:layout_marginBottom="@dimen/nui_espacio_m"
            android:clipChildren="false">

            <View
                android:layout_width="110dp"
                android:layout_height="40dp"
                android:background="@drawable/fondo_carpeta_trasera" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="22dp"
                android:background="@drawable/fondo_carpeta_trasera" />

            <!-- Hojas ya metidas, asomando por arriba -->
            <LinearLayout
                android:id="@+id/papeles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="36dp"
                android:gravity="center_horizontal"
                android:orientation="horizontal" />

            <!-- Mientras no hay hojas: dónde soltar los documentos -->
            <TextView
                android:id="@+id/zonaSoltar"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="34dp"
                android:background="@drawable/fondo_zona_soltar"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:text="↓  Suelta aquí los documentos"
                android:textAppearance="@style/TextAppearance.Nui.Cuerpo.Fuerte"
                android:textColor="@color/nui_madera_oscura" />

            <!-- Tapa delantera: se estira hasta arriba al cerrarse -->
            <FrameLayout
                android:id="@+id/tapa"
                android:layout_width="match_parent"
                android:layout_height="230dp"
                android:layout_gravity="bottom"
                android:background="@drawable/fondo_carpeta_tapa"
                android:elevation="4dp"
                android:outlineProvider="none"><!-- elevation solo para quedar encima de las hojas; sin sombra difuminada -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/nui_espacio_l">

                    <!-- Etiqueta de papel pegada en la tapa -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/fondo_papel"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/nui_espacio_m"
                        android:paddingVertical="@dimen/nui_espacio_s"
                        android:rotation="-1">

                        <TextView
                            android:id="@+id/tvTituloCarpeta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="2"
                            android:textAppearance="@style/TextAppearance.Nui.Titular.M" />

                        <TextView
                            android:id="@+id/tvContador"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:accessibilityLiveRegion="polite"
                            android:textAppearance="@style/TextAppearance.Nui.Codigo"
                            android:textColor="@color/nui_apagado" />
                    </LinearLayout>

                    <!-- Firma (con la carpeta cerrada) -->
                    <LinearLayout
                        android:id="@+id/zonaFirma"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/nui_espacio_m"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="150dp">

                            <com.example.nuietsiit.util.LienzoFirma
                                android:id="@+id/lienzoFirma"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/fondo_firma"
                                android:contentDescription="Recuadro para firmar con el dedo" />

                            <TextView
                                android:id="@+id/tvFirmaAqui"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:text="Firma aquí"
                                android:textAppearance="@style/TextAppearance.Nui.Titular.M"
                                android:textColor="@color/nui_apagado" />

                            <TextView
                                android:id="@+id/tvFirmadoHuella"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/fondo_papel"
                                android:gravity="center"
                                android:text="Firmado con tu huella"
                                android:textAppearance="@style/TextAppearance.Nui.Titular.M"
                                android:visibility="gone" />
                        </FrameLayout>

                        <LinearLayout
                            android:id="@+id/botonesFirma"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnBorrarFirma"
                                style="@style/Widget.Nui.Boton.Texto"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="@dimen/nui_espacio_xl"
                                android:minWidth="0dp"
                                android:paddingHorizontal="0dp"
                                android:text="Borrar firma"
                                android:textColor="@color/nui_madera_oscura" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnFirmarHuella"
                                style="@style/Widget.Nui.Boton.Texto"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minWidth="0dp"
                                android:paddingHorizontal="0dp"
                                android:text="Usar mi huella"
                                android:textColor="@color/nui_madera_oscura"
                                android:visibility="gone" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvNota"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginTop="@dimen/nui_espacio_xs"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textAppearance="@style/TextAppearance.Nui.Cuerpo"
                        android:textColor="@color/nui_madera_oscura"
                        android:textSize="@dimen/nui_texto_s" />
                </LinearLayout>

                <!-- Sello: mantener el dedo hasta el "clac" -->
                <FrameLayout
                    android:id="@+id/sello"
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="@dimen/nui_espacio_l"
                    android:layout_marginBottom="@dimen/nui_espacio_l"
                    android:background="@drawable/fondo_sello"
                    android:clickable="true"
                    android:contentDescription="Sello: mantén el dedo para sellar"
                    android:elevation="3dp"
                    android:focusable="true"
                    android:outlineProvider="none"
                    android:visibility="gone">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/anilloSello"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:max="1000"
                        app:indicatorColor="@color/nui_granada"
                        app:indicatorInset="0dp"
                        app:indicatorSize="84dp"
                        app:trackColor="@color/nui_granada_tinte"
                        app:trackThickness="6dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center_horizontal"
                        android:importantForAccessibility="no"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/nui_ic_granada"
                            android:tint="@color/nui_granada" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mantén"
                            android:textAppearance="@style/TextAppearance.Nui.Etiqueta"
                            android:textColor="@color/nui_granada" />
                    </LinearLayout>
                </FrameLayout>

                <!-- Marca que deja el sello -->
                <TextView
                    android:id="@+id/marcaSello"
                    style="@style/Widget.Nui.Sello"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="18dp"
                    android:rotation="-12"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Encima de todo al final: arrastrar la carpeta hacia arriba -->
            <View
                android:id="@+id/capaLanzar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="true"
                android:contentDescription="Carpeta sellada: lánzala hacia arriba para enviar"
                android:elevation="6dp"
                android:focusable="true"
                android:visibility="gone" />
        </FrameLayout>
    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCerrarCarpeta"
        style="@style/Widget.Nui.Boton.Texto"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="@dimen/nui_espacio_l"
        android:text="Cerrar la carpeta sin los opcionales"
        android:visibility="gone" />

    <!-- Con la carpeta cerrada: volver a abrirla para ver o cambiar los documentos -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAbrirCarpeta"
        style="@style/Widget.Nui.Boton.Texto"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="@dimen/nui_espacio_l"
        android:text="Abrir la carpeta para revisar los documentos"
        android:textColor="@color/nui_apagado"
        android:visibility="gone" />

    <!-- Alternativa sin gesto: aparece unos segundos después de sellar -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEnviar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/nui_espacio_l"
        android:layout_marginBottom="@dimen/nui_espacio_m"
        android:minHeight="56dp"
        android:text="Enviar sin lanzar"
        android:visibility="gone" />
</LinearLayout>
