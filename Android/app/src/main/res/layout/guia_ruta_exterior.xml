<?xml version="1.0" encoding="utf-8"?>
<!-- Bloque de la guía (F4) dentro del panel de "Cómo llegar". Lo maneja GuiaRutaExterior. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/llRutaExtGuia"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">

    <!-- Aviso del momento ("¡Bájate ahora!"): aparece unos segundos con la vibración -->
    <TextView
        android:id="@+id/tvGuiaAviso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@color/nui_acento"
        android:padding="10dp"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="72dp"
            android:layout_height="72dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/nui_linea"
            app:strokeWidth="1dp">

            <ImageView
                android:id="@+id/ivGuiaFoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Foto del sitio"
                android:scaleType="centerCrop" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvGuiaEtapa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/nui_acento"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvGuiaInstruccion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/nui_tinta"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Brújula: apunta al siguiente objetivo (parada, bajada o entrada) -->
        <LinearLayout
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivGuiaFlecha"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Dirección a seguir"
                android:src="@drawable/ic_flecha_guia" />

            <TextView
                android:id="@+id/tvGuiaMetros"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/nui_apagado"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Cuenta atrás grande: "Tu bus pasa en 4 min", "Quedan 9 min" -->
    <TextView
        android:id="@+id/tvGuiaCuenta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/nui_tinta"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvGuiaLlegada"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/nui_acento"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuiaSimular"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:backgroundTint="@color/nui_suave"
            android:text="▶ Simular ×10"
            android:textAllCaps="false"
            android:textColor="@color/nui_tinta"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:strokeColor="#FFE3D1"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuiaTerminar"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:backgroundTint="@color/nui_tinta"
            android:text="Terminar"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            app:cornerRadius="14dp" />
    </LinearLayout>
</LinearLayout>
