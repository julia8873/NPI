<?xml version="1.0" encoding="utf-8"?>
<!-- Mis gestiones: la carpeta con tus citas y solicitudes, cada una en su ficha -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#F8FAFC"
        app:titleTextAppearance="@style/TextAppearance.Nui.Titular" />

    <!-- Pestañas de la carpeta -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/nui_superficie"
        app:tabIndicatorColor="@color/nui_resaltado"
        app:tabIndicatorHeight="3dp"
        app:tabRippleColor="@color/nui_resalte"
        app:tabSelectedTextColor="@color/nui_tinta"
        app:tabTextAppearance="@style/TextAppearance.Nui.Cuerpo.Fuerte"
        app:tabTextColor="@color/nui_apagado" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/nui_borde"
        android:background="@color/nui_papel_sombra" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vpGestiones"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
