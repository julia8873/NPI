<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Cabecera -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:paddingHorizontal="8dp">

        <TextView
            android:id="@+id/tvProfesorado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/ivIcono"
            android:text="Profesorado y Tutorías"
            android:textColor="#000000"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivIcono"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:clickable="true"
            android:contentDescription="Icono de perfil"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:src="@drawable/icono" />
    </RelativeLayout>

    <!-- Recuadro expansible para las tutorías / estado del usuario -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardTutorias"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="24dp"
        app:cardBackgroundColor="#F5F5F5"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <!-- 1. VISTA SIN SESIÓN INICIADA -->
            <LinearLayout
                android:id="@+id/layoutLoggedOut"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:gravity="center"
                    android:text="No has iniciado sesión aún.\nPara gestionar y ver tus tutorías reservadas accede con tus credenciales."
                    android:textColor="#666666"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btnLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Iniciar sesión" />
            </LinearLayout>

            <!-- 2. VISTA CON SESIÓN INICIADA (Tutorías reservadas) -->
            <LinearLayout
                android:id="@+id/layoutLoggedIn"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvUserWelcome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="Tus tutorías reservadas:"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <LinearLayout
                        android:id="@+id/contenedorTutoriasReservadas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <!-- Tarjetas de tutorías reservadas dinámicas -->
                    </LinearLayout>
                </ScrollView>

            </LinearLayout>

        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <!-- EL BOTÓN PARA EL BUSCADOR DE PROFESORADO -->
    <Button
        android:id="@+id/btnBuscarProfesorado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="10dp"
        android:padding="16dp"
        android:text="¿Quieres buscar profesorado o tutorías?"
        android:textSize="16sp"
        app:cornerRadius="24dp" />

</LinearLayout>
