<?xml version="1.0" encoding="utf-8"?>
<!-- QR a pantalla completa por encima de todo el justificante (ver Justificante.mostrarCapaQR).
     Fondo blanco liso: lo tiene que leer el lector de la ventanilla. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nui_superficie"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingBottom="@dimen/nui_espacio_l"
    android:visibility="gone">

    <ImageView
        android:id="@+id/ivCapaQR"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <!-- si no se lee el QR, el código se puede dictar -->
    <TextView
        android:id="@+id/tvCapaCodigo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Nui.Codigo"
        android:textSize="@dimen/nui_texto_xl" />

    <TextView
        android:id="@+id/tvCapaEstado"
        style="@style/Widget.Nui.Sello"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/nui_espacio_s"
        android:visibility="gone" />
</LinearLayout>
