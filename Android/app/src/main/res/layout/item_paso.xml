<?xml version="1.0" encoding="utf-8"?>
<!-- Página del ViewPager2 (tiene que ocupar todo, match_parent): un paso = una ficha del fichero -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/nui_espacio_l">

    <LinearLayout
        style="@style/Widget.Nui.Ficha"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Cabecera de la ficha: "Paso 2 de 5" -->
        <TextView
            android:id="@+id/tvNumero"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:gravity="center_vertical"
            android:textAppearance="@style/TextAppearance.Nui.Codigo"
            android:textColor="#FF8C42" />

        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/nui_espacio_l"
            android:accessibilityHeading="true"
            android:textAppearance="@style/TextAppearance.Nui.Titular" />

        <!-- Sin scroll: si el texto es largo, la letra se reduce hasta que quepa -->
        <TextView
            android:id="@+id/tvDescripcion"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/nui_espacio_m"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="@dimen/nui_texto_cuerpo"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:textAppearance="@style/TextAppearance.Nui.Cuerpo" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAccionFinal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/nui_espacio_m"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
