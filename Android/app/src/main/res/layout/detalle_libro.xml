<?xml version="1.0" encoding="utf-8"?>
<!-- Detalle de un libro: el libro de frente sobre su balda y debajo su ficha de catálogo (design system NUI) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nui_superficie"
    android:orientation="vertical">

    <!-- Cabecera de sala: yesería + arquería -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/nui_yeseria"
        app:titleTextAppearance="@style/TextAppearance.Nui.Titular" />

    <com.example.nuietsiit.ui.TramaAzulejo
        android:layout_width="match_parent"
        android:layout_height="@dimen/nui_arqueria"
        android:importantForAccessibility="no"
        app:tesela="@drawable/nui_arqueria" />

    <com.example.nuietsiit.ui.HojasPaginadas
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/nui_espacio_l">

            <!-- El libro de frente, apoyado en un trozo de balda -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:clipChildren="false">

                <ImageView
                    android:id="@+id/ivPortada"
                    android:layout_width="@dimen/biblio_libro_grande_ancho"
                    android:layout_height="@dimen/biblio_libro_grande_alto"
                    android:background="@drawable/nui_libro"
                    android:importantForAccessibility="no"
                    android:paddingStart="@dimen/nui_borde_sello"
                    android:paddingTop="@dimen/nui_borde_sello"
                    android:paddingEnd="@dimen/nui_libro_canto"
                    android:paddingBottom="@dimen/nui_libro_canto"
                    android:scaleType="centerCrop"
                    android:transitionName="portada" />

                <TextView
                    android:id="@+id/tvPrestado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="@drawable/nui_marca"
                    android:paddingHorizontal="@dimen/nui_espacio_s"
                    android:paddingVertical="@dimen/biblio_marca_vertical"
                    android:rotation="-8"
                    android:text="@string/prestado_label"
                    android:textAppearance="@style/TextAppearance.Nui.Etiqueta"
                    android:textColor="@color/nui_granada"
                    android:visibility="gone" />
            </FrameLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/nui_espacio_s"
                android:layout_marginHorizontal="@dimen/nui_espacio_xl"
                android:background="@color/nui_madera"
                android:importantForAccessibility="no" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/nui_espacio_xs"
                android:layout_marginHorizontal="@dimen/nui_espacio_xl"
                android:background="@color/nui_madera_oscura"
                android:importantForAccessibility="no" />

            <!-- Ficha de catálogo: signatura en la cabecera -->
            <LinearLayout
                style="@style/Widget.Nui.Ficha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/nui_espacio_xl"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSignatura"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/nui_espacio_xl"
                    android:gravity="center_vertical"
                    android:textAppearance="@style/TextAppearance.Nui.Codigo" />

                <TextView
                    android:id="@+id/tvTitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/nui_espacio_m"
                    android:accessibilityHeading="true"
                    android:textAppearance="@style/TextAppearance.Nui.Titular" />

                <TextView
                    android:id="@+id/tvAutores"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/nui_espacio_xs"
                    android:textAppearance="@style/TextAppearance.Nui.Cuerpo.Secundario" />

                <TextView
                    android:id="@+id/tvDisponibilidad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/nui_espacio_m"
                    android:textAppearance="@style/TextAppearance.Nui.Cuerpo.Fuerte" />

                <LinearLayout
                    android:id="@+id/filaUbicacion"
                    style="@style/DatoLibro">

                    <TextView
                        style="@style/NombreDatoLibro"
                        android:text="@string/ubicacion_label" />

                    <TextView
                        android:id="@+id/tvUbicacion"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.Nui.Cuerpo" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnComoLlegar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/nui_espacio_l"
                android:minHeight="@dimen/biblio_flotante_alto"
                android:text="@string/btn_como_llegar_biblio"
                app:icon="@drawable/ic_nui_mapa" />

            <!-- Datos de edición: papel aparte, en letra de oficina -->
            <TextView
                style="@style/TituloExplorar"
                android:layout_marginTop="@dimen/nui_espacio_xl"
                android:text="@string/datos_edicion_titulo" />

            <LinearLayout
                android:id="@+id/papelEdicion"
                style="@style/Widget.Nui.Papel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="@dimen/nui_espacio_s">

                <LinearLayout
                    android:id="@+id/filaEditorial"
                    style="@style/DatoLibro">

                    <TextView
                        style="@style/NombreDatoLibro"
                        android:text="@string/editorial_label" />

                    <TextView
                        android:id="@+id/tvEditorial"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.Nui.Cuerpo" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/filaEdicion"
                    style="@style/DatoLibro">

                    <TextView
                        style="@style/NombreDatoLibro"
                        android:text="@string/edicion_label" />

                    <TextView
                        android:id="@+id/tvEdicion"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.Nui.Cuerpo" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/filaAnio"
                    style="@style/DatoLibro">

                    <TextView
                        style="@style/NombreDatoLibro"
                        android:text="@string/anio_label" />

                    <TextView
                        android:id="@+id/tvAnio"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.Nui.Codigo" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/filaIsbn"
                    style="@style/DatoLibro">

                    <TextView
                        style="@style/NombreDatoLibro"
                        android:text="@string/isbn_label" />

                    <TextView
                        android:id="@+id/tvIsbn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.Nui.Codigo" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.example.nuietsiit.ui.HojasPaginadas>

    <!-- Zócalo: filete de oro + alicatado -->
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/biblio_filete"
        android:background="@color/nui_oro" />

    <com.example.nuietsiit.ui.TramaAzulejo
        android:layout_width="match_parent"
        android:layout_height="@dimen/nui_zocalo"
        android:importantForAccessibility="no" />
</LinearLayout>