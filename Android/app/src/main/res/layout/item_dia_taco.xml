<?xml version="1.0" encoding="utf-8"?>
<!-- Un día en Pedir cita: tarjeta de calendario (día de la semana en naranja, número grande, mes).
     Elegido = setSelected(true): sombra naranja del papel. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:background="@drawable/nui_papel_estado"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingBottom="@dimen/nui_espacio_xs">

    <TextView
        android:id="@+id/tvSemana"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="@dimen/nui_espacio_xs"
        android:textAppearance="@style/TextAppearance.Nui.Etiqueta"
        android:textColor="@color/nui_resaltado" />

    <TextView
        android:id="@+id/tvNumero"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Nui.Titular" />

    <TextView
        android:id="@+id/tvMes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Nui.Codigo"
        android:textColor="@color/nui_apagado"
        android:textSize="@dimen/nui_texto_etiqueta" />
</LinearLayout>