<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/contenidoSignUp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="28dp">

        <!-- 1. CABECERA: Botón volver · Título · Botón Chat Asistente -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="12dp"
            android:paddingBottom="16dp">

            <ImageButton
                android:id="@+id/btnVolver"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_circulo_blanco_volver"
                android:contentDescription="@string/volver"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_chevron_left"
                app:tint="#1A1A1A" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:letterSpacing="-0.02"
                android:maxLines="1"
                android:text="@string/titulo_crear_cuenta"
                android:textColor="#1A1A1A"
                android:textSize="22sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/cardMascotaAyudante"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_nui_chat"
                android:clickable="true"
                android:contentDescription="@string/abrir_asistente"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_nui_bot"
                    app:tint="@android:color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/chat"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- 2. SECCIÓN HERO: Tarjeta Bienvenido -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_tarjeta_bienvenido"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="18dp">

            <FrameLayout
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/bg_icono_naranja_bienvenido">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_person_add"
                    app:tint="@android:color/white" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="-0.01"
                    android:text="@string/bienvenido"
                    android:textColor="#1A1A1A"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/crea_cuenta_correo_ugr"
                    android:textColor="#666666"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 3. CAMPOS DE FORMULARIO -->

        <!-- Campo 1: Nombre completo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_input_box"
            android:gravity="center_vertical"
            android:minHeight="62dp"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="14dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_input_user"
                app:tint="#8A8A8E" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nombre_completo"
                    android:textColor="#666666"
                    android:textSize="11.5sp" />

                <EditText
                    android:id="@+id/etNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:background="@null"
                    android:hint="@string/hint_nombre_apellidos"
                    android:inputType="textPersonName"
                    android:maxLines="1"
                    android:padding="0dp"
                    android:singleLine="true"
                    android:textColor="#1A1A1A"
                    android:textColorHint="#9E9E9E"
                    android:textSize="14.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Campo 2: Correo universitario -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_input_box"
            android:gravity="center_vertical"
            android:minHeight="62dp"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="14dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_input_mail"
                app:tint="#8A8A8E" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/correo_universitario"
                    android:textColor="#666666"
                    android:textSize="11.5sp" />

                <EditText
                    android:id="@+id/etCorreo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:background="@null"
                    android:hint="@string/hint_correo_ugr"
                    android:inputType="textEmailAddress"
                    android:maxLines="1"
                    android:padding="0dp"
                    android:singleLine="true"
                    android:textColor="#1A1A1A"
                    android:textColorHint="#9E9E9E"
                    android:textSize="14.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Campo 3: Contraseña -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_input_box"
            android:gravity="center_vertical"
            android:minHeight="62dp"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="14dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_input_lock"
                app:tint="#8A8A8E" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/contrasena"
                    android:textColor="#666666"
                    android:textSize="11.5sp" />

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:background="@null"
                    android:hint="@string/crea_una_contrasena"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:padding="0dp"
                    android:singleLine="true"
                    android:textColor="#1A1A1A"
                    android:textColorHint="#9E9E9E"
                    android:textSize="14.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Campo 4: Confirmar contraseña -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_input_box"
            android:gravity="center_vertical"
            android:minHeight="62dp"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="14dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_input_shield"
                app:tint="#8A8A8E" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/confirmar_contrasena"
                    android:textColor="#666666"
                    android:textSize="11.5sp" />

                <EditText
                    android:id="@+id/etConfirmPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:background="@null"
                    android:hint="@string/repite_la_contrasena"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:padding="0dp"
                    android:singleLine="true"
                    android:textColor="#1A1A1A"
                    android:textColorHint="#9E9E9E"
                    android:textSize="14.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 4. BOTÓN CREAR CUENTA -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCrearCuenta"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="6dp"
            android:backgroundTint="#F25C19"
            android:letterSpacing="0.01"
            android:text="@string/btn_crear_cuenta"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="28dp"
            app:elevation="4dp" />

        <!-- 5. PIE: "¿Ya tienes una cuenta?" y Botón Iniciar sesión -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="12dp"
            android:text="@string/ya_tienes_cuenta"
            android:textColor="#666666"
            android:textSize="13.5sp" />

        <LinearLayout
            android:id="@+id/btnVolverLogin"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/bg_boton_iniciar_sesion_tarjeta"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <FrameLayout
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_icono_azul_login">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_login_arrow"
                    app:tint="@android:color/white" />
            </FrameLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:letterSpacing="-0.01"
                android:text="@string/iniciar_sesion"
                android:textColor="#1A1A1A"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="6dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_right"
                app:tint="#F25C19" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>