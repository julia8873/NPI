<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:fitsSystemWindows="true">

    <!-- Foto de la ruta -->
    <ImageView
        android:id="@+id/ivFotoRuta"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:contentDescription="@string/foto_ruta_desc"
        android:scaleType="centerCrop" />

    <!-- Capa superior: Módulo de información y estado (HUD Superior) -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_margin="16dp"
        app:cardBackgroundColor="#CC0F172A"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:strokeColor="#33FFFFFF"
        app:strokeWidth="1dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@id/cardCerrarCruz"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvRumbo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rumbo_desconocido"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="Rumbo: 180° S" />

                <TextView
                    android:id="@+id/tvEstadoFoto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#FDBA74"
                    android:textSize="14sp"
                    tools:text="🚶 Avanza 3 pasos al frente" />

                <SeekBar
                    android:id="@+id/sbRumboManual"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:progressTint="#FF8C42"
                    android:thumbTint="#FF8C42"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Botón de Cierre -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCerrarCruz"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#FF8C42"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/cerrar_desc"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    app:tint="#FFFFFF" />
            </com.google.android.material.card.MaterialCardView>
        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Capa inferior: Barra de Navegación Flotante Mejorada -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardControles"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="28dp"
        app:cardBackgroundColor="#E60F172A"
        app:cardCornerRadius="32dp"
        app:cardElevation="12dp"
        app:strokeColor="#475569"
        app:strokeWidth="1.5dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <!-- Botón ANTERIOR -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAnterior"
                style="@style/Widget.MaterialComponents.Button.Icon"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="12dp"
                android:contentDescription="@string/btn_paso_anterior"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:visibility="gone"
                app:backgroundTint="#334155"
                app:cornerRadius="26dp"
                app:icon="@android:drawable/ic_media_previous"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconTint="#FFFFFF"
                app:strokeColor="#64748B"
                app:strokeWidth="1dp" />

            <!-- Botón SIGUIENTE -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSiguiente"
                style="@style/Widget.MaterialComponents.Button.Icon"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:contentDescription="@string/btn_paso_siguiente"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:visibility="gone"
                app:backgroundTint="#FF8C42"
                app:cornerRadius="26dp"
                app:icon="@android:drawable/ic_media_next"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconTint="#FFFFFF"
                app:rippleColor="#FFB380"
                app:strokeColor="#FFB380"
                app:strokeWidth="1dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</FrameLayout>