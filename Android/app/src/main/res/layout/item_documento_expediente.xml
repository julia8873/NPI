<?xml version="1.0" encoding="utf-8"?>
<!-- Documento sobre la mesa del expediente: vacío (toca para fotografiar) o lleno (arrástralo a la carpeta) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="124dp"
    android:layout_height="168dp"
    android:layout_marginHorizontal="6dp"
    android:background="@drawable/fondo_documento_vacio"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/ivMiniatura"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <!-- Vacío: cámara y qué hacer -->
    <LinearLayout
        android:id="@+id/grupoVacio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="20dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:layout_width="@dimen/nui_toque_min"
            android:layout_height="@dimen/nui_toque_min"
            android:background="@drawable/nui_tesela"
            android:backgroundTint="@color/nui_papel_sombra"
            android:importantForAccessibility="no"
            android:padding="@dimen/nui_espacio_m"
            android:src="@drawable/nui_ic_camara"
            android:tint="@color/nui_tinta" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/nui_espacio_xs"
            android:gravity="center"
            android:text="Toca para\nfotografiar"
            android:textAppearance="@style/TextAppearance.Nui.Cuerpo.Secundario"
            android:textSize="@dimen/nui_texto_etiqueta" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvOpcional"
        style="@style/Widget.Nui.Etiqueta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:background="@drawable/fondo_papel"
        android:text="Opcional"
        android:textColor="@color/nui_apagado"
        android:visibility="gone" />

    <!-- Lleno: indica hacia dónde llevarlo -->
    <TextView
        android:id="@+id/tvALaCarpeta"
        style="@style/Widget.Nui.Etiqueta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="@dimen/nui_espacio_s"
        android:text="↓ A la carpeta"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvNombre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/nui_papel"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:padding="6dp"
        android:textAppearance="@style/TextAppearance.Nui.Cuerpo.Fuerte"
        android:textSize="@dimen/nui_texto_etiqueta" />
</FrameLayout>
