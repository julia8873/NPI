<?xml version="1.0" encoding="utf-8"?>
<!-- Una comunidad: tarjeta blanca con el icono en el color de la plataforma, nombre, descripción y estado -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Seccion.Tarjeta"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="5dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/ivIconoComunidad"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/sec_circulo"
            android:importantForAccessibility="no"
            android:padding="11dp"
            android:src="@drawable/nui_ic_movil" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNombreComunidad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/sec_texto"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDescComunidad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.Seccion.Secundario" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvPlataforma"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
