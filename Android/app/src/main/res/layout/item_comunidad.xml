<?xml version="1.0" encoding="utf-8"?>
<!-- Una comunidad: papel pulsable con la tesela de la plataforma, nombre, descripción y estado -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.Nui.Papel.Pulsable"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/nui_espacio_s"
    android:gravity="center_vertical"
    android:minHeight="@dimen/nui_toque_min"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/ivIconoComunidad"
        android:layout_width="@dimen/nui_toque_min"
        android:layout_height="@dimen/nui_toque_min"
        android:background="@drawable/nui_tesela"
        android:importantForAccessibility="no"
        android:padding="@dimen/nui_espacio_m"
        android:src="@drawable/nui_ic_movil" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/nui_espacio_m"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNombreComunidad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Nui.Cuerpo.Fuerte" />

        <TextView
            android:id="@+id/tvDescComunidad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.Nui.Cuerpo.Secundario" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvPlataforma"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/nui_espacio_s"
        android:textAppearance="@style/TextAppearance.Nui.Etiqueta" />
</LinearLayout>
