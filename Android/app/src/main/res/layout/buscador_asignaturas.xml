<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="20dp"
    android:gravity="center_horizontal">

    <!-- Título superior y botón de volver -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp">

        <TextView
            android:id="@+id/btnVolver"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Volver"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FF9800"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Buscador"
            android:textSize="22sp"
            android:textColor="#000000"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Barra de búsqueda directa -->
    <EditText
        android:id="@+id/etBuscadorRapido"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Buscar asignatura por nombre..."
        android:background="@android:drawable/editbox_background_normal"
        android:padding="12dp"
        android:drawableStart="@android:drawable/ic_menu_search"
        android:drawablePadding="8dp"
        android:layout_marginBottom="16dp"/>

    <!-- CONTENEDOR 1: Lista de Grados (Con Scroll) -->
    <ScrollView
        android:id="@+id/scrollGrados"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Selecciona tu Grado:"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"
                android:textColor="#333333"/>

            <LinearLayout
                android:id="@+id/contenedorBotonesGrados"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <!-- Las tarjetas dinámicas se insertan aquí desde Java -->
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- CONTENEDOR 2: La Ruleta Mágica de Cursos -->
    <LinearLayout
        android:id="@+id/layoutRuletaCursos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvTituloGradoSeleccionado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="[Nombre del Grado]"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp"
            android:textColor="#FF9800"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Desliza para elegir el curso"
            android:textSize="14sp"
            android:layout_marginBottom="24dp"
            android:textColor="#666666"/>

        <!-- Ruleta Mágica personalizada -->
        <com.example.nuietsiit.activities.secciones.asignaturas.RuletaCursosView
            android:id="@+id/ruletaCursosView"
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:layout_gravity="center" />
    </LinearLayout>

    <!-- CONTENEDOR 3: Resultados de la Búsqueda -->
    <ScrollView
        android:id="@+id/scrollResultados"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTituloResultados"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Resultados:"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"
                android:textColor="#333333"/>

            <LinearLayout
                android:id="@+id/contenedorResultados"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <!-- Las tarjetas de ASIGNATURAS dinámicas se insertan aquí -->
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</LinearLayout>