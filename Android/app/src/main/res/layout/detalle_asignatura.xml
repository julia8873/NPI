<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="20dp">

    <!-- Título superior y botón de volver -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp">

        <TextView
            android:id="@+id/btnVolverDetalle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Volver"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FF9800"
            android:clickable="true"
            android:focusable="true"
            android:layout_centerVertical="true"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Ficha Asignatura"
            android:textSize="20sp"
            android:textColor="#000000"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Información principal -->
    <TextView
        android:id="@+id/tvNombreAsignatura"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nombre de la Asignatura"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvCodigoAsignatura"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Código: N/A"
        android:textSize="16sp"
        android:textColor="#666666"
        android:layout_marginBottom="24dp"/>

    <!-- Bloque de datos académicos -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#F5F5F5"
        android:padding="16dp"
        android:layout_marginBottom="32dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Créditos ECTS"
                android:textSize="14sp"
                android:textColor="#666666"/>
            <TextView
                android:id="@+id/tvCreditos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#FF9800"/>
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#CCCCCC"
            android:layout_marginHorizontal="8dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cuatrimestre"
                android:textSize="14sp"
                android:textColor="#666666"/>
            <TextView
                android:id="@+id/tvCuatrimestre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#FF9800"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Botón externo a la Guía Docente -->
    <Button
        android:id="@+id/btnGuiaDocente"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Ver Guía Docente"
        android:textAllCaps="false"
        android:textSize="18sp"
        android:backgroundTint="#FF9800"
        android:textColor="#FFFFFF" />

</LinearLayout>