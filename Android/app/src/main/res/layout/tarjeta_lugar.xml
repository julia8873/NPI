<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta inferior al tocar un edificio en el mapa: "¿Te llevo?" (TarjetaLugar) -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tarjetaLugar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:layout_margin="10dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="24dp"
    app:cardElevation="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="14dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/ivTarjetaLugarFoto"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:background="@color/nui_suave"
                android:contentDescription="@string/foto_lugar_desc"
                android:scaleType="centerCrop" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTarjetaLugarCerrar"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end|top"
                android:layout_margin="6dp"
                android:contentDescription="@string/cerrar_desc"
                app:backgroundTint="#99000000"
                app:icon="@android:drawable/ic_menu_close_clear_cancel"
                app:iconTint="@android:color/white" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvTarjetaLugarPregunta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="18dp"
            android:layout_marginTop="12dp"
            android:text="@string/pregunta_te_llevo"
            android:textColor="@color/nui_acento"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTarjetaLugarNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="18dp"
            android:textColor="@color/nui_tinta"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTarjetaLugarTiempo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="18dp"
            android:layout_marginTop="2dp"
            android:textColor="@color/nui_tinta"
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTarjetaLugarLlevame"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginHorizontal="14dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/nui_acento"
            android:text="@string/btn_llevame_aqui"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="17sp"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            app:icon="@android:drawable/ic_menu_directions"
            app:iconTint="@android:color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTarjetaLugarDentro"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginHorizontal="14dp"
            android:layout_marginTop="4dp"
            android:backgroundTint="@color/nui_suave"
            android:text="@string/btn_ver_por_dentro"
            android:textAllCaps="false"
            android:textColor="@color/nui_tinta"
            android:textSize="15sp"
            android:visibility="gone"
            app:cornerRadius="16dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>