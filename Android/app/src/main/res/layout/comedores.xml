<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollComedores"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nui_superficie"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/contenidoComedores"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/nui_superficie"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="16dp">

        <!-- 1. CABECERA: Empieza con el botón volver y el título de comedores -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <ImageButton
                android:id="@+id/btnVolver"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_circulo_blanco_volver"
                android:contentDescription="@string/volver_menu_principal"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_chevron_left"
                app:tint="@color/nui_tinta" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="-0.02"
                android:maxLines="1"
                android:text="@string/seccion_comedores"
                android:textColor="@color/nui_tinta"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/cardMascotaAyudante"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_nui_chat"
                android:clickable="true"
                android:contentDescription="@string/abrir_asistente"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_nui_bot"
                    app:tint="@android:color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/chat"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ivIcono"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_nui_circulo_suave"
                android:clickable="true"
                android:contentDescription="@string/perfil"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:src="@drawable/ic_nui_usuario"
                app:tint="@color/nui_tinta" />
        </LinearLayout>

        <!-- 2. TARJETA DEL COMEDOR MÁS CERCANO (Al pulsar muestra el menú con todos los comedores disponibles) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardComedorCercano"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@color/nui_suave"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp"
            app:strokeColor="#FFE3D1"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp">

                <FrameLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_nui_icono_ficha"
                    android:backgroundTint="#EF4444">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_nui_comedores"
                        app:tint="@android:color/white" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvTagComedorCercano"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_nui_etiqueta"
                            android:paddingHorizontal="7dp"
                            android:paddingVertical="2dp"
                            android:text="@string/tag_comedor_cercano"
                            android:textColor="@color/nui_acento"
                            android:textSize="9.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvMensajeComedoreCercano"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="@string/mensaje_comedor_cercano"
                        android:textColor="@color/nui_tinta"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="6dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_nui_chevron_der"
                    app:tint="@color/nui_apagado" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3. TRES BOTONES DE ACCIÓN: Horario, Precios y Alternar Vegetariano/Normal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHorario"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:backgroundTint="@color/nui_suave"
                app:cornerRadius="12dp"
                app:strokeColor="#FFE3D1"
                app:strokeWidth="1dp"
                android:paddingHorizontal="4dp"
                android:text="@string/btn_horario"
                android:textColor="@color/nui_tinta"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPrecios"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:backgroundTint="@color/nui_suave"
                app:cornerRadius="12dp"
                app:strokeColor="#FFE3D1"
                app:strokeWidth="1dp"
                android:paddingHorizontal="4dp"
                android:text="@string/btn_precios"
                android:textColor="@color/nui_tinta"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTipoMenu"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1.2"
                android:layout_marginStart="4dp"
                android:backgroundTint="#FF7A2F"
                app:cornerRadius="12dp"
                android:paddingHorizontal="4dp"
                android:text="@string/btn_tipo_menu"
                android:textColor="@android:color/white"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerEnMapa"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="8dp"
            android:backgroundTint="@color/nui_suave"
            app:cornerRadius="12dp"
            app:strokeColor="#FFE3D1"
            app:strokeWidth="1dp"
            android:text="@string/btn_ver_en_mapa"
            android:textColor="@color/nui_tinta"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- 4. CARTEL DEL MENÚ CON LA FOTO DE FONDO CONSERVADA -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center">

            <!-- Cartel menú con dimensiones 340dp x 440dp (como estaba antes) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardMenu"
                android:layout_width="340dp"
                android:layout_height="440dp"
                android:layout_centerHorizontal="true"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <!-- Imagen de fondo del cartel (restringida solo al cuadro) -->
                    <ImageView
                        android:id="@+id/imgFondoMenu"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/menu_fondo" />

                    <!-- Capa oscura semitransparente para legibilidad de textos -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#60000000" />

                    <!-- Textos del menú del día organizados por secciones -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="32dp"
                        android:paddingTop="20dp"
                        android:paddingBottom="24dp">

                        <TextView
                            android:id="@+id/tvDia"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="2dp"
                            android:translationX="-4dp"
                            android:fontFamily="serif"
                            android:letterSpacing="0.04"
                            android:text="@string/dia_default"
                            android:textColor="@android:color/white"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <!-- SECCIÓN 1: PRIMER PLATO -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="42dp"
                            android:orientation="vertical">

                            <!-- Divider encima del título -->
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginBottom="8dp"
                                android:background="#33FFFFFF" />

                            <!-- Título con icono -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/primer_plato" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:fontFamily="serif"
                                    android:letterSpacing="0.06"
                                    android:text="@string/primer_plato_titulo"
                                    android:textColor="#FFA726"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <!-- Divider debajo del título -->
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginTop="8dp"
                                android:layout_marginBottom="6dp"
                                android:background="#33FFFFFF" />

                            <!-- Nombre del plato (sin divider después) -->
                            <TextView
                                android:id="@+id/tvPrimerPlato"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="30dp"
                                android:fontFamily="serif"
                                android:lineSpacingExtra="2dp"
                                android:text="@string/primer_plato_default"
                                android:textColor="@android:color/white"
                                android:textSize="14.5sp" />
                        </LinearLayout>

                        <!-- SECCIÓN 2: SEGUNDO PLATO -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:orientation="vertical">

                            <!-- Divider encima del título -->
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginBottom="8dp"
                                android:background="#33FFFFFF" />

                            <!-- Título con icono -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/segundo_plato" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:fontFamily="serif"
                                    android:letterSpacing="0.06"
                                    android:text="@string/segundo_plato_titulo"
                                    android:textColor="#FFA726"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <!-- Divider debajo del título -->
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginTop="8dp"
                                android:layout_marginBottom="6dp"
                                android:background="#33FFFFFF" />

                            <!-- Nombre del plato (sin divider después) -->
                            <TextView
                                android:id="@+id/tvSegundoPlato"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="30dp"
                                android:fontFamily="serif"
                                android:lineSpacingExtra="2dp"
                                android:text="@string/segundo_plato_default"
                                android:textColor="@android:color/white"
                                android:textSize="14.5sp" />
                        </LinearLayout>

                        <!-- SECCIÓN 3: POSTRE -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:orientation="vertical">

                            <!-- Divider encima del título -->
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginBottom="8dp"
                                android:background="#33FFFFFF" />

                            <!-- Título con icono -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/postre" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:fontFamily="serif"
                                    android:letterSpacing="0.06"
                                    android:text="@string/postre_titulo"
                                    android:textColor="#FFA726"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <!-- Divider debajo del título -->
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginTop="8dp"
                                android:layout_marginBottom="6dp"
                                android:background="#33FFFFFF" />

                            <!-- Nombre del plato (sin divider después) -->
                            <TextView
                                android:id="@+id/tvPostre"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="30dp"
                                android:fontFamily="serif"
                                android:lineSpacingExtra="2dp"
                                android:text="@string/postre_default"
                                android:textColor="@android:color/white"
                                android:textSize="14.5sp" />
                        </LinearLayout>

                    </LinearLayout>

                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <!-- Flecha Día Anterior (Abajo, en el centro) -->
            <ImageButton
                android:id="@+id/btnDiaAnterior"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignBottom="@id/cardMenu"
                android:layout_alignStart="@id/cardMenu"
                android:layout_marginBottom="15dp"
                android:layout_marginStart="90dp"
                android:background="@drawable/boton_circular"
                android:contentDescription="@string/dia_anterior_desc"
                android:elevation="10dp"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_chevron_left"
                app:tint="@android:color/white"
                android:visibility="gone" />

            <!-- Flecha Día Siguiente (Abajo, en el centro) -->
            <ImageButton
                android:id="@+id/btnDiaSiguiente"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignBottom="@id/cardMenu"
                android:layout_alignEnd="@id/cardMenu"
                android:layout_marginBottom="10dp"
                android:layout_marginEnd="90dp"
                android:background="@drawable/boton_circular"
                android:contentDescription="@string/dia_siguiente_desc"
                android:elevation="10dp"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_chevron_right"
                app:tint="@android:color/white" />

        </RelativeLayout>

        <!-- 5. SELECTOR DE DÍAS DE LA SEMANA (Lunes a Viernes) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTituloSeleccionDia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.06"
                android:text="@string/titulo_semana_default"
                android:textColor="@color/nui_apagado"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Lunes (deshabilitado en simulación) -->
            <TextView
                android:id="@+id/btnDiaL"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:background="@drawable/circulo_dia_deshabilitado"
                android:gravity="center"
                android:paddingHorizontal="2dp"
                android:text="@string/dia_lun"
                android:textColor="#AAAAAA"
                android:textStyle="bold"
                android:textSize="11.5sp"
                android:maxLines="1" />

            <!-- Martes -->
            <TextView
                android:id="@+id/btnDiaM"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/circulo_dia_seleccionado"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="2dp"
                android:text="@string/dia_mar"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="11.5sp"
                android:maxLines="1" />

            <!-- Miércoles -->
            <TextView
                android:id="@+id/btnDiaX"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/circulo_dia_disponible"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="2dp"
                android:text="@string/dia_mie"
                android:textColor="#FF8C42"
                android:textStyle="bold"
                android:textSize="11.5sp"
                android:maxLines="1" />

            <!-- Jueves -->
            <TextView
                android:id="@+id/btnDiaJ"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/circulo_dia_disponible"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="2dp"
                android:text="@string/dia_jue"
                android:textColor="#FF8C42"
                android:textStyle="bold"
                android:textSize="11.5sp"
                android:maxLines="1" />

            <!-- Viernes -->
            <TextView
                android:id="@+id/btnDiaV"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:background="@drawable/circulo_dia_disponible"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="2dp"
                android:text="@string/dia_vie"
                android:textColor="#FF8C42"
                android:textStyle="bold"
                android:textSize="11.5sp"
                android:maxLines="1" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>