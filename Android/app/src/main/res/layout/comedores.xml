<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Cabecera: Texto de Comedor cercano e Icono ajustes -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:paddingHorizontal="8dp">

            <TextView
                android:id="@+id/tvMensajeComedoreCercano"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/ivIcono"
                android:text="¡Tu comedor más cercano!"
                android:textColor="#000000"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivIcono"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:clickable="true"
                android:contentDescription="Icono de perfil"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:src="@drawable/icono" />
        </RelativeLayout>

        <!-- Ubicación actual del usuario -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingHorizontal="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvUbicacionActual"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 Tu ubicación: Obteniendo posición..."
                android:textColor="#555555"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Carta menú -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardMenu"
            android:layout_width="340dp"
            android:layout_height="440dp"
            android:layout_marginTop="30dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Imagen de fondo (restringida solo al cuadro) -->
                <ImageView
                    android:id="@+id/imgFondoMenu"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/menu_fondo" />

                <!-- Capa oscura semitransparente para que resalte el texto -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#60000000" />

                <!-- Textos del menú del día -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvDia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:layout_gravity="center"
                        android:text="Día"
                        android:fontFamily="serif"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <!-- Primer Plato con icono a la izquierda -->
                    <TextView
                        android:id="@+id/tvPrimerPlato"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="50dp"
                        android:layout_marginStart="40dp"
                        android:layout_marginEnd="40dp"
                        android:gravity="center_vertical"
                        android:text="Primer plato"
                        android:fontFamily="serif"
                        android:textColor="@android:color/white"
                        android:textSize="15sp" />

                    <!-- Segundo Plato con icono a la izquierda -->
                    <TextView
                        android:id="@+id/tvSegundoPlato"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="25dp"
                        android:layout_marginStart="40dp"
                        android:layout_marginEnd="40dp"
                        android:gravity="center_vertical"
                        android:text="Segundo plato"
                        android:fontFamily="serif"
                        android:textColor="@android:color/white"
                        android:textSize="15sp" />

                    <!-- Postre con icono a la izquierda -->
                    <TextView
                        android:id="@+id/tvPostre"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="25dp"
                        android:layout_marginStart="40dp"
                        android:layout_marginEnd="40dp"
                        android:gravity="center_vertical"
                        android:text="Postre"
                        android:fontFamily="serif"
                        android:textColor="@android:color/white"
                        android:textSize="15sp" />

                    <!-- Horario -->
                    <TextView
                        android:id="@+id/tvHorario"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="30dp"
                        android:layout_marginLeft="40dp"
                        android:layout_marginRight="20dp"
                        android:text="Horario"
                        android:fontFamily="serif"
                        android:textColor="@android:color/white"
                        android:textSize="16sp" />

                    <!-- Precio -->
                    <TextView
                        android:id="@+id/tvPrecio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:layout_marginLeft="40dp"
                        android:layout_marginRight="20dp"
                        android:text="Precio"
                        android:fontFamily="serif"
                        android:textColor="@android:color/white"
                        android:textSize="16sp" />


                </LinearLayout>

            </FrameLayout>

        </androidx.cardview.widget.CardView>

        <!-- Botones debajo del precio pero dentro del contenedor para cambiar de día -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <Button
                android:id="@+id/btnDiaAnterior"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#FF8C42"
                android:text="◀ Día Ant."
                android:textColor="@android:color/white"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnDiaSiguiente"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:backgroundTint="#FF8C42"
                android:text="Día Sig. ▶"
                android:textColor="@android:color/white"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvOtrosComedores"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:layout_gravity="left"
            android:text="Comedores ordenados por cercanía:"
            android:textColor="@android:color/black"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Lista de comedores ordenados por distancia -->
        <LinearLayout
            android:id="@+id/llListaComedores"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="30dp"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>