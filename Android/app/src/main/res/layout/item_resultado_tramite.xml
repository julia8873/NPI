<?xml version="1.0" encoding="utf-8"?>
<!-- Paso 3 de "¿Qué necesitas?": la ficha del trámite encontrado, en grande -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.Nui.Ficha"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/nui_espacio_s"
    android:background="@drawable/nui_ficha"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical">

    <!-- Cabecera de la ficha: categoría (sobre la línea granada) -->
    <TextView
        android:id="@+id/tvCategoria"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:gravity="center_vertical"
        android:textAppearance="@style/TextAppearance.Nui.Etiqueta" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/nui_espacio_l"
        android:orientation="horizontal">

        <!-- Icono de la respuesta elegida, sobre su tesela -->
        <ImageView
            android:id="@+id/ivIcono"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/nui_tesela_estrella"
            android:importantForAccessibility="no"
            android:padding="14dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/nui_espacio_m"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Nui.Titular" />

            <TextView
                android:id="@+id/tvEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/nui_espacio_s"
                android:textAppearance="@style/TextAppearance.Nui.Etiqueta"
                android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvDescripcion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/nui_espacio_m"
        android:textAppearance="@style/TextAppearance.Nui.Cuerpo" />

    <!-- Qué te espera: documentos y pasos -->
    <TextView
        android:id="@+id/tvResumen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/nui_espacio_m"
        android:textAppearance="@style/TextAppearance.Nui.Codigo" />
</LinearLayout>
