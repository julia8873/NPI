<?xml version="1.0" encoding="utf-8"?>
<!-- Noticias (design system NUI): yesería + arquería, pestañas de papel con las categorías y un carrusel
     de fichas (una por aviso, sin scroll). Zócalo abajo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nui_superficie"
    android:orientation="vertical">

    <!-- Cabecera de sala: yesería + arquería -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/nui_yeseria"
        app:titleTextAppearance="@style/TextAppearance.Nui.Titular" />

    <com.example.nuietsiit.ui.TramaAzulejo
        android:layout_width="match_parent"
        android:layout_height="@dimen/nui_arqueria"
        android:importantForAccessibility="no"
        app:tesela="@drawable/nui_arqueria" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/nui_espacio_l"
        android:paddingTop="@dimen/nui_espacio_s">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSinLeer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityLiveRegion="polite"
                android:textAppearance="@style/TextAppearance.Nui.Cuerpo.Fuerte" />

            <!-- Leer los avisos en voz alta (también acercándote el móvil a la oreja: LectorAvisos) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEscuchar"
                style="@style/Widget.Nui.Boton.Texto"
                android:layout_width="@dimen/nui_toque_min"
                android:layout_height="@dimen/nui_toque_min"
                android:contentDescription="Escuchar los avisos"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:padding="0dp"
                app:icon="@drawable/nui_ic_altavoz"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tvMarcarTodo"
                style="@style/Widget.Nui.Boton.Texto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Marcar leídos" />
        </LinearLayout>

        <!-- Categorías: pestañas de papel, todas a la vista (se crean en Noticias.crearPestanas) -->
        <com.example.nuietsiit.ui.PestanasPapel
            android:id="@+id/pestanasCategorias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Se ve un trocito de la ficha anterior y la siguiente para que se note que se desliza -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/vpAnuncios"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="@dimen/nui_espacio_xxl"
            android:paddingVertical="@dimen/nui_espacio_m" />

        <TextView
            android:id="@+id/tvVacio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="No hay avisos aquí."
            android:textAppearance="@style/TextAppearance.Nui.Titular.M"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvPagina"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:gravity="center"
        android:paddingBottom="@dimen/nui_espacio_s"
        android:textAppearance="@style/TextAppearance.Nui.Codigo" />

    <!-- Zócalo: filete de oro + alicatado -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/nui_oro" />

    <com.example.nuietsiit.ui.TramaAzulejo
        android:layout_width="match_parent"
        android:layout_height="@dimen/nui_zocalo"
        android:importantForAccessibility="no" />
</LinearLayout>
