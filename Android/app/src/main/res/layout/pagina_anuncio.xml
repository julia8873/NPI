<?xml version="1.0" encoding="utf-8"?>
<!-- Una página del carrusel de Noticias: tarjeta grande con el aviso. Si es urgente el borde se pone rojo -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardAnuncio"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginHorizontal="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="24dp"
    app:cardElevation="4dp"
    app:strokeColor="#FF8C42"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvEmoji"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/fondo_circulo"
                android:gravity="center"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/tvMeta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:textColor="#666666"
                android:textSize="13sp" />

            <View
                android:id="@+id/vNoLeido"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="@drawable/punto_naranja" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvUrgente"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/fondo_fecha"
            android:backgroundTint="#D32F2F"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:text="🚨 URGENTE"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:maxLines="3"
            android:textColor="#000000"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvContenido"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:lineSpacingExtra="3dp"
            android:textColor="#333333"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvLeerMas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Toca para leerlo entero"
            android:textColor="#FF8C42"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
