<?xml version="1.0" encoding="utf-8"?>
<!-- Una página del carrusel de Noticias: tarjeta blanca con el aviso. Si es urgente, borde y etiqueta rojos. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/fichaAnuncio"
        style="@style/Widget.Seccion.Tarjeta"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivIcono"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/sec_circulo"
                    android:importantForAccessibility="no"
                    android:padding="11dp" />

                <TextView
                    android:id="@+id/tvMeta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textAppearance="@style/TextAppearance.Seccion.Secundario" />

                <!-- No leído: puntito naranja -->
                <View
                    android:id="@+id/vNoLeido"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/sec_punto"
                    android:contentDescription="@string/nui_not_nuevo" />

                <!-- Guardar para luego (= inclinar el móvil hacia ti): marcapáginas vacío o relleno -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGuardarAviso"
                    style="@style/Widget.Seccion.Boton.Texto"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="4dp"
                    android:contentDescription="@string/nui_not_btn_guardar"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:padding="0dp"
                    app:icon="@drawable/nui_ic_guardar"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvUrgente"
                style="@style/Widget.Seccion.Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:backgroundTint="@color/sec_error"
                android:text="@string/nui_not_urgente"
                android:textAllCaps="true"
                android:textColor="@android:color/white"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:ellipsize="end"
                android:maxLines="3"
                android:textAppearance="@style/TextAppearance.Seccion.Titulo" />

            <TextView
                android:id="@+id/tvContenido"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:lineSpacingExtra="3dp"
                android:textAppearance="@style/TextAppearance.Seccion.Cuerpo" />

            <TextView
                android:id="@+id/tvLeerMas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/nui_not_toca_leer"
                android:textColor="@color/nui_acento"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
