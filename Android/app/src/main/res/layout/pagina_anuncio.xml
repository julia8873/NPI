<?xml version="1.0" encoding="utf-8"?>
<!-- Una página del carrusel de Noticias: ficha grande con el aviso. Si es urgente lleva sello granada. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginHorizontal="@dimen/nui_espacio_xs"
    android:clipChildren="false">

    <LinearLayout
        android:id="@+id/fichaAnuncio"
        style="@style/Widget.Nui.Ficha"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:orientation="vertical">

        <!-- Cabecera de la ficha: categoría · hace cuánto, y "Nuevo" si no está leído -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvMeta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:textAppearance="@style/TextAppearance.Nui.Etiqueta" />

            <TextView
                android:id="@+id/vNoLeido"
                style="@style/Widget.Nui.Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nuevo" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/nui_espacio_m"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Tesela con el icono de la categoría (color y tinte por código) -->
            <ImageView
                android:id="@+id/ivIcono"
                android:layout_width="@dimen/nui_icono_objeto"
                android:layout_height="@dimen/nui_icono_objeto"
                android:background="@drawable/nui_tesela"
                android:importantForAccessibility="no"
                android:padding="@dimen/nui_espacio_s" />

            <TextView
                android:id="@+id/tvTitulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/nui_espacio_m"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="3"
                android:textAppearance="@style/TextAppearance.Nui.Titular" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvContenido"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/nui_espacio_m"
            android:layout_weight="1"
            android:ellipsize="end"
            android:textAppearance="@style/TextAppearance.Nui.Cuerpo" />

        <TextView
            android:id="@+id/tvLeerMas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/nui_espacio_s"
            android:text="Toca para leerlo entero"
            android:textAppearance="@style/TextAppearance.Nui.Cuerpo.Fuerte"
            android:textColor="@color/nui_acento_profundo" />
    </LinearLayout>

    <!-- Urgente: sello granada encima de la ficha -->
    <TextView
        android:id="@+id/tvUrgente"
        style="@style/Widget.Nui.Sello"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/nui_espacio_l"
        android:layout_marginBottom="@dimen/nui_espacio_xxl"
        android:text="Urgente"
        android:visibility="gone" />
</FrameLayout>
