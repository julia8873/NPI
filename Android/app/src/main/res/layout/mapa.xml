<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- 1. CABECERA: Título de la sección e icono de perfil -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:paddingHorizontal="4dp">

        <TextView
            android:id="@+id/tvTituloMapa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/ivIcono"
            android:text="Mapa Interactivo"
            android:textColor="#000000"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivIcono"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:clickable="true"
            android:contentDescription="Icono de perfil"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:src="@drawable/icono" />
    </RelativeLayout>

    <!-- 2. BUSCADOR SUPERIOR (Arriba) -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="16dp"
        app:cardElevation="3dp"
        app:strokeColor="#E0E0E0"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="4dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_search"
                app:tint="#FF8C42"
                android:contentDescription="Buscar" />

            <EditText
                android:id="@+id/etBuscadorMapa"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@null"
                android:hint="Buscar aula, despacho, laboratorio o servicio..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="#000000"
                android:textColorHint="#888888"
                android:textSize="14sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 3. RECUADRO CENTRAL PARA EL MAPA -->
    <!-- 3. RECUADRO CENTRAL PARA EL MAPA -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardMapaContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginVertical="8dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp"
        app:strokeColor="#FF8C42"
        app:strokeWidth="2dp">

        <FrameLayout
            android:id="@+id/flContenedorMapa"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- VISTA INTERACTIVA DEL MAPA -->
            <ImageView
                android:id="@+id/ivMapa"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Plano interactivo de la planta"
                android:scaleType="fitCenter" />

            <!-- Mensaje flotante con la planta actual (opcional, como overlay) -->
            <TextView
                android:id="@+id/tvPlantaActual"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="12dp"
                android:background="#80000000"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="Planta Baja (Planta 0)"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 4. BARRA INFERIOR DE PLANTAS (Selector de planta -1, 0, 1, 2, 3...) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="8dp"
            android:text="Selecciona Planta:"
            android:textColor="#333333"
            android:textSize="14sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/llBarraPlantas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="2dp">

                <!-- Botón Planta -1 -->
                <Button
                    android:id="@+id/btnPlantaMinus1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="Planta -1"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="#888888"
                    app:cornerRadius="16dp" />

                <!-- Botón Planta 0 (Seleccionada por defecto) -->
                <Button
                    android:id="@+id/btnPlanta0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="Planta Baja"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="#FF8C42"
                    app:cornerRadius="16dp" />

                <!-- Botón Planta 1 -->
                <Button
                    android:id="@+id/btnPlanta1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="Planta 1"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="#888888"
                    app:cornerRadius="16dp" />

                <!-- Botón Planta 2 -->
                <Button
                    android:id="@+id/btnPlanta2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="Planta 2"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="#888888"
                    app:cornerRadius="16dp" />

                <!-- Botón Planta 3 -->
                <Button
                    android:id="@+id/btnPlanta3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="Planta 3"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="#888888"
                    app:cornerRadius="16dp" />

                <!-- Botón Planta 4 -->
                <Button
                    android:id="@+id/btnPlanta4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="Planta 4"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="#888888"
                    app:cornerRadius="16dp" />

                <!-- Botón Planta 5 -->
                <Button
                    android:id="@+id/btnPlanta5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="Planta 5"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="#888888"
                    app:cornerRadius="16dp" />

            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

</LinearLayout>
