<?xml version="1.0" encoding="utf-8"?>
<!-- Tapa delantera de la carpeta: melocotón claro con canto naranja suave -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="@color/nui_madera" />
            <corners android:radius="@dimen/nui_radio_papel" />
        </shape>
    </item>
    <item android:top="@dimen/nui_borde" android:bottom="@dimen/nui_sombra_papel">
        <shape>
            <solid android:color="@color/nui_oro_claro" />
            <corners android:radius="@dimen/nui_radio_papel" />
        </shape>
    </item>
</layer-list>
