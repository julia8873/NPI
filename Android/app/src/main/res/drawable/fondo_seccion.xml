<?xml version="1.0" encoding="utf-8"?>
<!-- La mesa iluminada mientras se arrastra una hoja fuera de la carpeta (SolicitudTramite) -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/nui_resaltado_tinte" />
    <stroke
        android:width="@dimen/nui_borde_sello"
        android:color="@color/nui_resaltado"
        android:dashWidth="7dp"
        android:dashGap="5dp" />
    <corners android:radius="@dimen/nui_radio_papel" />
</shape>
