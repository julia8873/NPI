<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FDFDFD" />
            <stroke
                android:width="1.5dp"
                android:color="#FF8C42" />
            <corners android:radius="10dp" />
            <padding
                android:left="14dp"
                android:top="8dp"
                android:right="36dp"
                android:bottom="8dp" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/ic_drop_down"
        android:gravity="end|center_vertical"
        android:right="12dp"
        android:width="20dp"
        android:height="20dp" />
</layer-list>

