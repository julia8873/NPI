<?xml version="1.0" encoding="utf-8"?>
<!-- CAMPO de formulario rellenable (EditText simple). Con foco: borde de tinta. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/nui_superficie" />
            <stroke android:width="2dp" android:color="@color/nui_tinta" />
            <corners android:radius="@dimen/nui_radio_papel" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/nui_suave" />
            <stroke android:width="@dimen/nui_borde" android:color="@color/nui_papel_sombra" />
            <corners android:radius="@dimen/nui_radio_papel" />
        </shape>
    </item>
</selector>
