<?xml version="1.0" encoding="utf-8"?>
<!-- CAMPO de formulario (EditText simple). Con foco: borde naranja. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/nui_superficie" />
            <stroke android:width="2dp" android:color="@color/nui_resaltado" />
            <corners android:radius="@dimen/nui_radio_boton" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/nui_superficie" />
            <stroke android:width="@dimen/nui_borde" android:color="#E2E8F0" />
            <corners android:radius="@dimen/nui_radio_boton" />
        </shape>
    </item>
</selector>
