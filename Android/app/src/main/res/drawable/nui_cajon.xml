<?xml version="1.0" encoding="utf-8"?>
<!-- CAJÓN DE FICHERO: madera con canto oscuro abajo. Dentro van fichas (Widget.Nui.Ficha). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="@color/nui_madera_oscura" />
            <corners android:radius="@dimen/nui_radio_papel" />
        </shape>
    </item>
    <item android:bottom="@dimen/nui_sombra_papel">
        <shape>
            <solid android:color="@color/nui_madera" />
            <corners android:radius="@dimen/nui_radio_papel" />
        </shape>
    </item>
</layer-list>
