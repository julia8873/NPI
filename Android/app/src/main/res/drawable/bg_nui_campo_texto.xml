<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Estado enfocado (borde naranja acento, fondo blanco) -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <stroke android:width="1.8dp" android:color="@color/nui_acento" />
            <corners android:radius="14dp" />
            <padding
                android:left="16dp"
                android:top="12dp"
                android:right="16dp"
                android:bottom="12dp" />
        </shape>
    </item>

    <!-- Estado por defecto (fondo suave, borde sutil) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/nui_suave" />
            <stroke android:width="1dp" android:color="#FFE3D1" />
            <corners android:radius="14dp" />
            <padding
                android:left="16dp"
                android:top="12dp"
                android:right="16dp"
                android:bottom="12dp" />
        </shape>
    </item>
</selector>

