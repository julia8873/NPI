<?xml version="1.0" encoding="utf-8"?>
<!-- Burbuja de chat de la vista previa de grupos: papel con borde de línea (tokens NUI) -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/nui_papel" />
    <stroke
        android:width="@dimen/nui_borde"
        android:color="@color/nui_linea" />
    <corners
        android:bottomLeftRadius="@dimen/nui_radio_burbuja"
        android:bottomRightRadius="@dimen/nui_radio_burbuja"
        android:topLeftRadius="@dimen/nui_radio_ficha"
        android:topRightRadius="@dimen/nui_radio_burbuja" />
</shape>
