<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Diálogos de Secretaría: blancos, radio 16dp y botones de texto naranja -->
    <style name="DialogoSecretaria" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/nui_acento_profundo</item>
        <item name="colorSurface">@color/nui_papel</item>
        <item name="colorSurfaceContainerHigh">@color/nui_papel</item>
        <item name="colorOnSurface">@color/nui_tinta</item>
        <item name="colorOnSurfaceVariant">@color/nui_apagado</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/FormaPapelSecretaria</item>
        <item name="materialAlertDialogTitleTextStyle">@style/DialogoSecretaria.Titulo</item>
        <item name="materialAlertDialogBodyTextStyle">@style/DialogoSecretaria.Cuerpo</item>
        <item name="buttonBarPositiveButtonStyle">@style/DialogoSecretaria.Boton</item>
        <item name="buttonBarNegativeButtonStyle">@style/DialogoSecretaria.Boton</item>
        <item name="buttonBarNeutralButtonStyle">@style/DialogoSecretaria.Boton</item>
    </style>

    <style name="FormaPapelSecretaria">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/nui_radio_papel</item>
    </style>

    <style name="DialogoSecretaria.Titulo" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textAppearance">@style/TextAppearance.Nui.Titular</item>
        <item name="android:textColor">@color/nui_tinta</item>
    </style>

    <style name="DialogoSecretaria.Cuerpo" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textAppearance">@style/TextAppearance.Nui.Cuerpo</item>
        <item name="android:textColor">@color/nui_tinta</item>
    </style>

    <style name="DialogoSecretaria.Boton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/nui_acento_profundo</item>
        <item name="rippleColor">@color/nui_resalte</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
