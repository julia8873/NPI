<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme forzado a Light -->
    <style name="Base.Theme.NUIETSIIT" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="android:windowBackground">#FFFFFF</item>
        <item name="android:colorBackground">#FFFFFF</item>
        <!-- NUI:INICIO design system (DisenoNUI/DESIGN.md). Quitar con DisenoNUI/revertir.sh -->
        <item name="colorPrimary">@color/nui_resaltado</item>
        <item name="colorOnPrimary">@color/nui_sobre_resaltado</item>
        <item name="colorPrimaryContainer">@color/nui_resaltado_tinte</item>
        <item name="colorOnPrimaryContainer">@color/nui_tinta</item>
        <item name="colorSecondary">@color/nui_cobalto</item>
        <item name="colorOnSecondary">@color/nui_superficie</item>
        <item name="colorSecondaryContainer">@color/nui_cobalto_tinte</item>
        <item name="colorOnSecondaryContainer">@color/nui_cobalto</item>
        <item name="colorTertiary">@color/nui_granada</item>
        <item name="colorOnTertiary">@color/nui_superficie</item>
        <item name="colorTertiaryContainer">@color/nui_granada_tinte</item>
        <item name="colorOnTertiaryContainer">@color/nui_granada</item>
        <item name="colorError">@color/nui_error</item>
        <item name="colorErrorContainer">@color/nui_granada_tinte</item>
        <item name="colorOnErrorContainer">@color/nui_granada</item>
        <item name="colorSurface">@color/nui_superficie</item>
        <item name="colorOnSurface">@color/nui_tinta</item>
        <item name="colorSurfaceVariant">@color/nui_suave</item>
        <item name="colorOnSurfaceVariant">@color/nui_apagado</item>
        <item name="colorSurfaceContainerLow">@color/nui_papel</item>
        <item name="colorSurfaceContainer">@color/nui_suave</item>
        <item name="colorOutline">@color/nui_papel_sombra</item>
        <item name="colorOutlineVariant">@color/nui_linea</item>
        <item name="android:textColorPrimary">@color/nui_tinta</item>
        <item name="android:textColorSecondary">@color/nui_apagado</item>
        <!-- Resaltado al tocar, controles activos y selección de texto con la paleta (no gris/lila de Material) -->
        <item name="colorControlHighlight">@color/nui_resalte</item>
        <item name="android:colorControlHighlight">@color/nui_resalte</item>
        <item name="colorControlActivated">@color/nui_resaltado</item>
        <item name="android:colorControlActivated">@color/nui_resaltado</item>
        <item name="colorControlNormal">@color/nui_apagado</item>
        <item name="colorAccent">@color/nui_resaltado</item>
        <item name="android:textColorHighlight">@color/nui_resalte_texto</item>
        <item name="android:textColorLink">@color/nui_cobalto</item>
        <item name="android:statusBarColor">@color/nui_superficie</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- Fuente por defecto vía apariencias base (no android:fontFamily: taparía los textAppearance Nui) -->
        <item name="android:textAppearanceSmall">@style/TextAppearance.Nui.Base.Small</item>
        <item name="android:textAppearanceMedium">@style/TextAppearance.Nui.Base.Medium</item>
        <item name="android:textAppearanceLarge">@style/TextAppearance.Nui.Base.Large</item>
        <item name="materialButtonStyle">@style/Widget.Nui.Boton</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Nui.Boton.Secundario</item>
        <item name="borderlessButtonStyle">@style/Widget.Nui.Boton.Texto</item>
        <!-- colores planos: sin el tinte naranja de M3 en superficies elevadas (hojas, diálogos) -->
        <item name="elevationOverlayEnabled">false</item>
        <item name="chipStyle">@style/Widget.Nui.Chip</item>
        <item name="toolbarStyle">@style/Widget.Nui.Toolbar</item>
        <item name="textInputStyle">@style/Widget.Nui.TextInputLayout</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.Nui.Titular</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Nui.Titular.M</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Nui.Cuerpo</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.Nui.Etiqueta</item>
        <!-- NUI:FIN -->
    </style>

    <style name="Theme.NUIETSIIT" parent="Base.Theme.NUIETSIIT" />

    <!-- Estilo para los números de los días (Negro puro) -->
    <style name="TextoDiasCalendario" parent="TextAppearance.AppCompat.Medium">
        <item name="android:textColor">#000000</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Estilo para las iniciales de los días de la semana (L, M, X...) (Negro puro) -->
    <style name="TextoSemanaCalendario" parent="TextAppearance.AppCompat.Caption">
        <item name="android:textColor">#000000</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Tema para cambiar el color del nombre del mes/año y selector de fecha (Negro puro) -->
    <style name="TemaCustomCalendario">
        <item name="android:textColorPrimary">#000000</item>
        <item name="colorOnSurface">#000000</item>
    </style>
</resources>
