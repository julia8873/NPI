<?xml version="1.0" encoding="utf-8"?>
<!-- Estilos de Actividades, Noticias y Comunidades, con los mismos valores que las pantallas de los demás
     (títulos 20sp en negrita, botones naranjas redondeados, tarjetas blancas con borde suave). -->
<resources>
    <style name="TextAppearance.Seccion" parent="" />
    <style name="Widget.Seccion" parent="" />
    <style name="TextAppearance.Seccion.Titulo">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/sec_texto</item>
    </style>
    <style name="TextAppearance.Seccion.Subtitulo">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/sec_texto</item>
    </style>
    <style name="TextAppearance.Seccion.Cuerpo">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/sec_texto_cuerpo</item>
    </style>
    <style name="TextAppearance.Seccion.Secundario">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/sec_texto_suave</item>
    </style>
    <style name="TextAppearance.Seccion.Etiqueta">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/sec_texto_suave</item>
    </style>

    <!-- Tarjeta blanca (MaterialCardView) -->
    <style name="Widget.Seccion.Tarjeta" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/sec_tarjeta</item>
        <item name="cardCornerRadius">22dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeColor">@color/sec_borde</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Etiqueta redondeada (el color se pone con backgroundTint y textColor) -->
    <style name="Widget.Seccion.Etiqueta">
        <item name="android:background">@drawable/sec_etiqueta</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
    </style>

    <!-- Botones: naranja lleno, contorno naranja y solo texto -->
    <style name="Widget.Seccion.Boton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/nui_acento</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="iconTint">@android:color/white</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">50dp</item>
    </style>
    <style name="Widget.Seccion.Boton.Secundario" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/nui_acento</item>
        <item name="iconTint">@color/nui_acento</item>
        <item name="strokeColor">@color/nui_acento</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">50dp</item>
    </style>
    <style name="Widget.Seccion.Boton.Texto" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/nui_acento</item>
        <item name="iconTint">@color/nui_acento</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Chip de filtro: igual que los del mapa (naranja al elegirlo) -->
    <style name="Widget.Seccion.Chip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/selector_chip_background_nui</item>
        <item name="chipStrokeColor">@color/selector_chip_stroke_nui</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">12dp</item>
        <item name="android:textColor">@color/selector_chip_text_nui</item>
        <item name="android:textStyle">bold</item>
        <item name="checkedIconVisible">false</item>
    </style>
</resources>
