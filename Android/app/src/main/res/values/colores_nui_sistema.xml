<?xml version="1.0" encoding="utf-8"?>
<!--
    TOKENS DE COLOR NUEVOS del design system NUI (ver DESIGN.md).
    Complementan a colores_nui.xml, que ya existe en la app y NO se modifica
    (nui_superficie, nui_tinta, nui_apagado, nui_linea, nui_acento, nui_suave, nui_tinte).
    La app no tiene modo oscuro: values-night/ hereda estos valores, no hace falta copiarlos.
-->
<resources>
    <!-- Papel -->
    <color name="nui_papel">#FBF8F2</color>           <!-- tarjetas "papel", fichas, documentos -->
    <color name="nui_papel_sombra">#E4DCCB</color>    <!-- sombra dura del papel apoyado -->

    <!-- Acento profundo: texto/iconos naranjas sobre fondo claro, estado pulsado -->
    <color name="nui_acento_profundo">#8E3520</color>

    <!-- Granada / alicatado: solo identidad (sellos, cenefas, detalles), no bloques grandes -->
    <color name="nui_granada">#A3233A</color>         <!-- tinta de sello, línea de ficha, error -->
    <color name="nui_granada_tinte">#F8E4E6</color>
    <color name="nui_cobalto">#1F4E79</color>         <!-- azulejo, enlaces, información -->
    <color name="nui_cobalto_tinte">#E3ECF4</color>
    <color name="nui_arrayan">#3C6E47</color>         <!-- éxito / completado (verde arrayán) -->
    <color name="nui_arrayan_tinte">#E4EFE5</color>

    <!-- La sala nazarí: cabecera de yesería, filetes de oro y madera de estanterías/cajones -->
    <color name="nui_yeseria">#F3EADB</color>         <!-- fondo de cabecera + arquería -->
    <color name="nui_yeseria_texto">#7A5A3A</color>   <!-- etiquetas sobre yesería -->
    <color name="nui_oro">#C9A66B</color>             <!-- filetes, bordes finos de libros y zócalo. Nunca texto -->
    <color name="nui_madera">#8B5E3C</color>          <!-- baldas, cajón del fichero -->
    <color name="nui_oro_claro">#D9BC86</color>       <!-- frente de carpeta / cartón -->
    <color name="nui_sombra_libro">#4D14110F</color>  <!-- sombra dura de un libro sobre la balda (tinta 30%) -->
    <color name="nui_madera_oscura">#6B4429</color>   <!-- canto inferior de la balda -->

    <!-- Semánticos (alias: usar estos en lógica de estado) -->
    <color name="nui_ok">@color/nui_arrayan</color>
    <color name="nui_info">@color/nui_cobalto</color>
    <color name="nui_aviso">@color/nui_acento_profundo</color>
    <color name="nui_error">@color/nui_granada</color>

    <!-- Transparencias -->
    <color name="nui_velo">#99000000</color>
    <color name="nui_transparente">#00000000</color>

    <!-- Resaltado al tocar (ripple) y selección de texto: naranja translúcido, no el gris/lila de Material -->
    <color name="nui_resalte">#29C0502E</color>          <!-- almagra 16 % -->
    <color name="nui_resalte_texto">#52C0502E</color>    <!-- almagra 32 %: texto seleccionado -->

    <!-- Colores por tema (Secretaría y cualquier sección que agrupe por tema). Un solo color fuerte por tarjeta. -->
    <color name="nui_tema_matricula">@color/nui_acento_profundo</color>
    <color name="nui_tema_matricula_tinte">@color/nui_resaltado_tinte</color>
    <color name="nui_tema_examenes">@color/nui_granada</color>          <!-- también convocatorias -->
    <color name="nui_tema_examenes_tinte">@color/nui_granada_tinte</color>
    <color name="nui_tema_creditos">@color/nui_cobalto</color>
    <color name="nui_tema_creditos_tinte">@color/nui_cobalto_tinte</color>
    <color name="nui_tema_titulos">@color/nui_arrayan</color>
    <color name="nui_tema_titulos_tinte">@color/nui_arrayan_tinte</color>
    <color name="nui_tema_certificados">@color/nui_madera</color>       <!-- también "otra cosa" -->
    <color name="nui_tema_certificados_tinte">@color/nui_yeseria</color>
    <color name="nui_tema_otros">@color/nui_apagado</color>

    <!-- RESALTADO: almagra, el rojo-teja de los muros de la Alhambra ("la roja"). Sustituye al naranja
         neón (nui_acento) en todo el design system: botón principal, selección, sombras de elegido, chips.
         Texto encima: nui_superficie (blanco, contraste AA). Para probar otro color, cambia solo estos tres. -->
    <color name="nui_resaltado">#C0502E</color>
    <color name="nui_resaltado_tinte">#F6E4DC</color>     <!-- fondo de lo seleccionado -->
    <color name="nui_sobre_resaltado">@color/nui_superficie</color>
</resources>
