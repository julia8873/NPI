<?xml version="1.0" encoding="utf-8"?>
<!-- TOKENS DE MEDIDA del design system NUI (ver NPI/DESIGN.md). Usar siempre estos, no dp/sp sueltos. -->
<resources>
    <!-- Espaciado: escala de 4dp -->
    <dimen name="nui_espacio_xs">4dp</dimen>
    <dimen name="nui_espacio_s">8dp</dimen>
    <dimen name="nui_espacio_m">12dp</dimen>
    <dimen name="nui_espacio_l">16dp</dimen>   <!-- margen lateral de pantalla -->
    <dimen name="nui_espacio_xl">24dp</dimen>  <!-- separación entre bloques -->
    <dimen name="nui_espacio_xxl">32dp</dimen>

    <!-- Radios: los del resto de la app (tarjetas 16dp, botones 12dp) -->
    <dimen name="nui_radio_ficha">16dp</dimen>  <!-- fichas, documentos -->
    <dimen name="nui_radio_papel">16dp</dimen>  <!-- tarjetas -->
    <dimen name="nui_radio_boton">12dp</dimen>  <!-- botones, campos -->
    <dimen name="nui_radio_burbuja">18dp</dimen> <!-- solo burbujas de chat y bottom sheets -->

    <!-- Sin sombras duras (se dejan a 0 para no tocar los drawables que las usan) -->
    <dimen name="nui_sombra_papel">0dp</dimen>
    <dimen name="nui_borde">1dp</dimen>
    <dimen name="nui_borde_sello">2dp</dimen>

    <!-- Tamaños táctiles e iconos -->
    <dimen name="nui_toque_min">48dp</dimen>
    <dimen name="nui_icono">24dp</dimen>
    <dimen name="nui_cenefa">16dp</dimen>       <!-- alto de la cenefa de azulejo -->
    <dimen name="nui_arqueria">22dp</dimen>     <!-- arquería bajo la cabecera -->
    <dimen name="nui_zocalo">28dp</dimen>       <!-- zócalo de alicatado al pie de la pantalla -->
    <dimen name="nui_libro_canto">2dp</dimen>   <!-- padding fin/abajo de un libro: igual que el marco (sin sombra) -->
    <dimen name="nui_icono_objeto">44dp</dimen> <!-- ilustraciones de objetos (rosa, carpeta, turno) -->
    <dimen name="nui_sombra_flotante">0dp</dimen>
    <dimen name="nui_mecha">3dp</dimen> <!-- barra de tiempo que se consume en un aviso (Deshacer) -->

    <!-- Escala tipográfica -->
    <dimen name="nui_texto_xl">32sp</dimen>     <!-- título de sección -->
    <dimen name="nui_texto_l">24sp</dimen>      <!-- título de pantalla / tarjeta grande -->
    <dimen name="nui_texto_m">20sp</dimen>      <!-- título de tarjeta -->
    <dimen name="nui_texto_cuerpo">16sp</dimen>
    <dimen name="nui_texto_s">14sp</dimen>
    <dimen name="nui_texto_etiqueta">12sp</dimen>
</resources>
