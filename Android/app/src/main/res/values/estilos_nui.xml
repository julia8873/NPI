<?xml version="1.0" encoding="utf-8"?>
<!--
    COMPONENTES del design system NUI (ver NPI/DESIGN.md).
    Uso: style="@style/Widget.Nui.X" o android:textAppearance="@style/TextAppearance.Nui.X".
    Los estilos solo referencian tokens (@color/nui_*, @dimen/nui_*, @font/nui_*).
-->
<resources>
    <!-- Raíz vacía: permite la herencia por nombre (Widget.Nui.X hereda de Widget.Nui) -->
    <style name="Widget.Nui" parent="" />

    <!-- ===================== TIPOGRAFÍA ===================== -->
    <!-- Titulares: Zilla Slab Bold (slab de mecanografía de secretaría). Máx. 1 XL por pantalla. -->
    <!-- Base del tema: lo que usa un TextView sin textAppearance propio. Solo cambia la fuente. -->
    <style name="TextAppearance.Nui.Base.Small" parent="@android:style/TextAppearance.Material.Small">
        <item name="android:fontFamily">@font/nui_texto</item>
        <item name="fontFamily">@font/nui_texto</item>
    </style>
    <style name="TextAppearance.Nui.Base.Medium" parent="@android:style/TextAppearance.Material.Medium">
        <item name="android:fontFamily">@font/nui_texto</item>
        <item name="fontFamily">@font/nui_texto</item>
    </style>
    <style name="TextAppearance.Nui.Base.Large" parent="@android:style/TextAppearance.Material.Large">
        <item name="android:fontFamily">@font/nui_texto</item>
        <item name="fontFamily">@font/nui_texto</item>
    </style>

    <style name="TextAppearance.Nui.Titular" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/nui_titular</item>
        <item name="android:fontFamily">@font/nui_titular</item>
        <item name="android:textColor">@color/nui_tinta</item>
        <item name="android:textSize">@dimen/nui_texto_l</item>
        <item name="android:letterSpacing">-0.01</item>
        <!-- interlineado propio: el de HeadlineSmall (32sp) separa demasiado los títulos de 2 líneas -->
        <item name="lineHeight">30sp</item>
        <item name="android:lineHeight">30sp</item>
    </style>
    <style name="TextAppearance.Nui.Titular.XL">
        <item name="android:textSize">@dimen/nui_texto_xl</item>
        <item name="lineHeight">38sp</item>
        <item name="android:lineHeight">38sp</item>
    </style>
    <style name="TextAppearance.Nui.Titular.M">
        <item name="android:textSize">@dimen/nui_texto_m</item>
        <item name="lineHeight">25sp</item>
        <item name="android:lineHeight">25sp</item>
    </style>

    <!-- Cuerpo: Atkinson Hyperlegible (diseñada para máxima legibilidad). -->
    <style name="TextAppearance.Nui.Cuerpo" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/nui_texto</item>
        <item name="android:fontFamily">@font/nui_texto</item>
        <item name="android:textColor">@color/nui_tinta</item>
        <item name="android:textSize">@dimen/nui_texto_cuerpo</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>
    <style name="TextAppearance.Nui.Cuerpo.Fuerte">
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.Nui.Cuerpo.Secundario">
        <item name="android:textColor">@color/nui_apagado</item>
        <item name="android:textSize">@dimen/nui_texto_s</item>
    </style>

    <!-- Etiqueta: mayúsculas espaciadas, para cabeceras de grupo ("PRÉSTAMOS ACTIVOS"). -->
    <style name="TextAppearance.Nui.Etiqueta" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">@font/nui_texto</item>
        <item name="android:fontFamily">@font/nui_texto</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/nui_texto_etiqueta</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textColor">@color/nui_apagado</item>
    </style>

    <!-- Código: IBM Plex Mono para datos "de oficina": signaturas (QA76.73 J38), nº de expediente,
         aulas (2.7), horas, fechas de devolución. -->
    <style name="TextAppearance.Nui.Codigo" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/nui_codigo</item>
        <item name="android:fontFamily">@font/nui_codigo</item>
        <item name="android:textSize">@dimen/nui_texto_s</item>
        <item name="android:textColor">@color/nui_tinta</item>
    </style>

    <!-- ===================== SUPERFICIES ===================== -->
    <!-- Tarjeta de papel apoyado. Para contenedores (LinearLayout/ConstraintLayout). -->
    <style name="Widget.Nui.Papel">
        <item name="android:background">@drawable/nui_papel</item>
        <item name="android:paddingStart">@dimen/nui_espacio_l</item>
        <item name="android:paddingTop">@dimen/nui_espacio_l</item>
        <!-- +3dp para compensar la sombra dura -->
        <item name="android:paddingEnd">19dp</item>
        <item name="android:paddingBottom">19dp</item>
    </style>
    <!-- Papel pulsable/seleccionable (cambia a naranja al pulsar o con setSelected(true)). -->
    <style name="Widget.Nui.Papel.Pulsable">
        <item name="android:background">@drawable/nui_papel_estado</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <!-- Ficha de catálogo: la primera fila (≈40dp) es la cabecera sobre la línea granada. -->
    <style name="Widget.Nui.Ficha">
        <item name="android:background">@drawable/nui_ficha</item>
        <item name="android:paddingStart">@dimen/nui_espacio_l</item>
        <item name="android:paddingTop">@dimen/nui_espacio_s</item>
        <item name="android:paddingEnd">19dp</item>
        <item name="android:paddingBottom">19dp</item>
    </style>

    <!-- ===================== ELEMENTOS ===================== -->
    <!-- Sello: confirmaciones y estados "oficiales" (PRESENTADO, DEVUELTO, CITA CONFIRMADA). Torcido a propósito. -->
    <style name="Widget.Nui.Sello">
        <item name="android:background">@drawable/nui_sello</item>
        <item name="android:fontFamily">@font/nui_titular</item>
        <item name="android:textColor">@color/nui_granada</item>
        <item name="android:textSize">@dimen/nui_texto_s</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">@dimen/nui_espacio_m</item>
        <item name="android:paddingEnd">@dimen/nui_espacio_m</item>
        <item name="android:paddingTop">@dimen/nui_espacio_s</item>
        <item name="android:paddingBottom">@dimen/nui_espacio_s</item>
        <item name="android:rotation">-6</item>
    </style>

    <!-- Etiqueta pequeña (categoría, estado, filtro). -->
    <style name="Widget.Nui.Etiqueta">
        <item name="android:background">@drawable/nui_etiqueta</item>
        <item name="android:fontFamily">@font/nui_texto</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/nui_acento_profundo</item>
        <item name="android:textSize">@dimen/nui_texto_etiqueta</item>
        <item name="android:paddingStart">@dimen/nui_espacio_s</item>
        <item name="android:paddingEnd">@dimen/nui_espacio_s</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
    </style>

    <!-- Campo de texto simple (EditText). Para TextInputLayout ya aplica el tema. -->
    <style name="Widget.Nui.Campo">
        <item name="android:background">@drawable/nui_campo</item>
        <item name="android:fontFamily">@font/nui_texto</item>
        <item name="android:textColor">@color/nui_tinta</item>
        <item name="android:textColorHint">@color/nui_apagado</item>
        <item name="android:textSize">@dimen/nui_texto_cuerpo</item>
        <item name="android:minHeight">@dimen/nui_toque_min</item>
        <item name="android:paddingStart">@dimen/nui_espacio_m</item>
        <item name="android:paddingEnd">@dimen/nui_espacio_m</item>
    </style>

    <!-- ===================== BOTONES (MaterialButton) ===================== -->
    <!-- Principal: naranja con texto tinta. Uno por pantalla. Se aplica solo por defecto (tema). -->
    <style name="Widget.Nui.Boton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/nui_resaltado</item>
        <item name="android:textColor">@color/nui_sobre_resaltado</item>
        <item name="iconTint">@color/nui_sobre_resaltado</item>
        <item name="rippleColor">@color/nui_acento_profundo</item>
        <item name="cornerRadius">@dimen/nui_radio_papel</item>
        <item name="android:fontFamily">@font/nui_texto</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/nui_texto_cuerpo</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:minHeight">@dimen/nui_toque_min</item>
    </style>
    <!-- Secundario: contorno de tinta. -->
    <style name="Widget.Nui.Boton.Secundario" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/nui_tinta</item>
        <item name="iconTint">@color/nui_tinta</item>
        <item name="strokeColor">@color/nui_tinta</item>
        <item name="strokeWidth">@dimen/nui_borde</item>
        <item name="rippleColor">@color/nui_resalte</item>
        <item name="cornerRadius">@dimen/nui_radio_papel</item>
        <item name="android:fontFamily">@font/nui_texto</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/nui_texto_cuerpo</item>
        <item name="android:minHeight">@dimen/nui_toque_min</item>
    </style>
    <!-- Texto: acciones menores ("Ver todo", "Cancelar"). -->
    <style name="Widget.Nui.Boton.Texto" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/nui_acento_profundo</item>
        <item name="iconTint">@color/nui_acento_profundo</item>
        <item name="rippleColor">@color/nui_resalte</item>
        <item name="android:fontFamily">@font/nui_texto</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ===================== CHIPS (filtros) ===================== -->
    <!-- Chip de filtro: papel con esquinas casi rectas; marcado = tinte + borde naranja. Por defecto en el tema. -->
    <style name="Widget.Nui.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/nui_chip_fondo</item>
        <item name="chipStrokeColor">@color/nui_chip_borde</item>
        <item name="chipStrokeWidth">@dimen/nui_borde</item>
        <item name="chipCornerRadius">3dp</item>
        <item name="android:textColor">@color/nui_chip_texto</item>
        <item name="android:fontFamily">@font/nui_texto</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/nui_texto_s</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipIconTint">@color/nui_chip_texto</item>
        <item name="closeIconTint">@color/nui_chip_texto</item>
    </style>
    <!-- Chip de acción especial (Explorar): cobalto; activo = cobalto lleno con texto blanco. -->
    <style name="Widget.Nui.Chip.Cobalto">
        <item name="chipBackgroundColor">@color/nui_chip_cobalto_fondo</item>
        <item name="chipStrokeColor">@color/nui_cobalto</item>
        <item name="android:textColor">@color/nui_chip_cobalto_texto</item>
        <item name="chipIconTint">@color/nui_chip_cobalto_texto</item>
        <item name="closeIconTint">@color/nui_chip_cobalto_texto</item>
    </style>

    <!-- ===================== BARRAS ===================== -->
    <style name="Widget.Nui.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/nui_superficie</item>
        <item name="titleTextAppearance">@style/TextAppearance.Nui.Titular.M</item>
        <item name="subtitleTextAppearance">@style/TextAppearance.Nui.Cuerpo.Secundario</item>
        <item name="navigationIconTint">@color/nui_tinta</item>
    </style>

    <style name="Widget.Nui.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/nui_tinta</item>
        <item name="hintTextColor">@color/nui_tinta</item>
        <item name="boxCornerRadiusTopStart">@dimen/nui_radio_papel</item>
        <item name="boxCornerRadiusTopEnd">@dimen/nui_radio_papel</item>
        <item name="boxCornerRadiusBottomStart">@dimen/nui_radio_papel</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/nui_radio_papel</item>
    </style>
    <!-- Desplegable (ExposedDropdownMenu) con el mismo marco que Widget.Nui.TextInputLayout -->
    <style name="Widget.Nui.TextInputLayout.Desplegable" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxStrokeColor">@color/nui_tinta</item>
        <item name="hintTextColor">@color/nui_tinta</item>
        <item name="endIconTint">@color/nui_tinta</item>
        <item name="boxCornerRadiusTopStart">@dimen/nui_radio_papel</item>
        <item name="boxCornerRadiusTopEnd">@dimen/nui_radio_papel</item>
        <item name="boxCornerRadiusBottomStart">@dimen/nui_radio_papel</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/nui_radio_papel</item>
    </style>

    <!-- Troquel: separador discontinuo de resguardo (justificante, billete) -->
    <style name="Widget.Nui.Troquel">
        <item name="android:layout_height">@dimen/nui_espacio_s</item>
        <item name="android:background">@drawable/nui_troquel</item>
        <item name="android:layerType">software</item><!-- las líneas discontinuas no se pintan con aceleración -->
        <item name="android:importantForAccessibility">no</item>
    </style>
</resources>
