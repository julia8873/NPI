<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Notificaciones de avisos urgentes y actividades (Miguel) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NUIETSIIT">
        <activity
            android:name=".activities.main.MenuPrincipal"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".activities.auth.Login"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".activities.auth.SignUp"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".activities.main.AjustesCuenta" />
        <activity android:name=".activities.secciones.Noticias" />
        <activity android:name=".activities.secciones.Mapa" />
        <activity android:name=".activities.secciones.Actividades" />
        <activity android:name=".activities.secciones.Asignaturas" />
        <activity android:name=".activities.secciones.Profesorado" />
        <activity android:name=".activities.secciones.Secretaria" />
        <activity android:name=".activities.secciones.secretaria.DetalleTramite" />
        <activity
            android:name=".activities.secciones.secretaria.PasosTramite"
            android:screenOrientation="portrait" />
        <activity android:name=".activities.secciones.Comedores" />
        <activity android:name=".activities.secciones.Biblioteca" />
    </application>

</manifest>